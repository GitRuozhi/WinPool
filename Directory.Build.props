<Project>
  <PropertyGroup>
    <!-- V0.3 is the architecture line; V0.32 is its current accepted checkpoint. -->
    <WinPoolArchitectureVersion>V0.3</WinPoolArchitectureVersion>
    <WinPoolDisplayVersion>V0.32</WinPoolDisplayVersion>
    <WinPoolTechnicalVersion>0.3.2.0</WinPoolTechnicalVersion>
    <Version>$(WinPoolTechnicalVersion)</Version>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>$(WinPoolTechnicalVersion)</FileVersion>
    <InformationalVersion>$(WinPoolDisplayVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
