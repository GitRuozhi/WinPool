<Project>
  <PropertyGroup>
    <!-- Va.bc: a=major, b=minor, c=one-digit iteration. V0.34 is the candidate project version. -->
    <WinPoolVersionMajor>0</WinPoolVersionMajor>
    <WinPoolVersionMinor>3</WinPoolVersionMinor>
    <WinPoolVersionIteration>4</WinPoolVersionIteration>
    <WinPoolArchitectureVersion>V$(WinPoolVersionMajor).$(WinPoolVersionMinor)</WinPoolArchitectureVersion>
    <WinPoolVersion>V$(WinPoolVersionMajor).$(WinPoolVersionMinor)$(WinPoolVersionIteration)</WinPoolVersion>

    <!-- Required numeric .NET/Windows fields are mechanical build metadata, not separate project versions. -->
    <Version>$(WinPoolVersionMajor).$(WinPoolVersionMinor).$(WinPoolVersionIteration)</Version>
    <AssemblyVersion>$(WinPoolVersionMajor).$(WinPoolVersionMinor).0.0</AssemblyVersion>
    <FileVersion>$(WinPoolVersionMajor).$(WinPoolVersionMinor).$(WinPoolVersionIteration).0</FileVersion>
    <InformationalVersion>$(WinPoolVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
