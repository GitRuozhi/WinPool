<Project>
  <PropertyGroup>
    <!-- Va.b: a=major, b=product line. V0.44 is the current project version. -->
    <WinPoolVersionMajor>0</WinPoolVersionMajor>
    <WinPoolVersionMinor>4</WinPoolVersionMinor>
    <WinPoolVersionIteration>4</WinPoolVersionIteration>
    <WinPoolArchitectureVersion>V$(WinPoolVersionMajor).$(WinPoolVersionMinor)</WinPoolArchitectureVersion>
    <WinPoolVersion Condition="'$(WinPoolVersionIteration)' == '0'">$(WinPoolArchitectureVersion)</WinPoolVersion>
    <WinPoolVersion Condition="'$(WinPoolVersionIteration)' != '0'">$(WinPoolArchitectureVersion)$(WinPoolVersionIteration)</WinPoolVersion>

    <!-- Required numeric .NET/Windows fields are mechanical build metadata, not separate project versions. -->
    <Version>$(WinPoolVersionMajor).$(WinPoolVersionMinor).$(WinPoolVersionIteration)</Version>
    <AssemblyVersion>$(WinPoolVersionMajor).$(WinPoolVersionMinor).0.0</AssemblyVersion>
    <FileVersion>$(WinPoolVersionMajor).$(WinPoolVersionMinor).$(WinPoolVersionIteration).0</FileVersion>
    <InformationalVersion>$(WinPoolVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!-- NU1900 is a failed advisory download, not a known vulnerability.
         TreatWarningsAsErrors must not fail restore when nuget.org audit data
         is unreachable. NU1901–NU1904 remain errors. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900</WarningsNotAsErrors>

    <!-- Generated output stays under artifacts. Source trees remain source. -->
    <WinPoolLocalOutputRoot>$(MSBuildThisFileDirectory)artifacts\$(Configuration)\</WinPoolLocalOutputRoot>
    <BaseOutputPath>$(MSBuildThisFileDirectory)artifacts\build\$(MSBuildProjectName)\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)artifacts\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'WinPool.App'
                         Or '$(MSBuildProjectName)' == 'WinPool.Agent'">
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>$(WinPoolLocalOutputRoot)</OutputPath>
  </PropertyGroup>
</Project>
