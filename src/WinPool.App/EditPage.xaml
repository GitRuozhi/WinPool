<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinPool_App.EditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinPool_App.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition MinHeight="160" Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition MinHeight="160" Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <ScrollViewer
                Padding="8"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>
                    <ItemsControl
                        x:Name="UpperTopologyControl"
                        HorizontalAlignment="Stretch">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:TopologyNodeControl
                                    HorizontalAlignment="Stretch"
                                    ViewModel="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel
                        Grid.Column="1"
                        Padding="12,4,4,4"
                        Spacing="8">
                        <TextBlock
                            x:Name="SelectedPartitionInfo"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <Button x:Name="ExtendButton" HorizontalAlignment="Stretch" Click="Extend_Click" />
                        <Button x:Name="ShrinkButton" HorizontalAlignment="Stretch" Click="Shrink_Click" />
                        <Button x:Name="DeletePartitionButton" HorizontalAlignment="Stretch" Click="DeletePartition_Click" />
                        <Button x:Name="FormatButton" HorizontalAlignment="Stretch" Click="Format_Click" />
                        <Button x:Name="NewPartitionButton" HorizontalAlignment="Stretch" Click="NewPartition_Click" />
                        <Button x:Name="InitializeButton" HorizontalAlignment="Stretch" Click="Initialize_Click" />
                        <Button x:Name="OfflineButton" HorizontalAlignment="Stretch" Click="Offline_Click" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <toolkit:GridSplitter
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Rows"
            Background="{ThemeResource CardStrokeColorDefaultBrush}" />

        <Border
            Grid.Row="2"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <ScrollViewer
                Padding="8"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>
                    <ItemsControl
                        x:Name="LowerTopologyControl"
                        HorizontalAlignment="Stretch">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:AdaptiveFlowPanel
                                    HorizontalAlignment="Stretch"
                                    MinimumItemWidth="160" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:TopologyNodeControl
                                    HorizontalAlignment="Stretch"
                                    ViewModel="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid
                        x:Name="PoolFormGrid"
                        Grid.Column="1"
                        Padding="8,0,0,0"
                        ColumnSpacing="8"
                        RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
