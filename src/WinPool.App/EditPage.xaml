<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinPool_App.EditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer HorizontalContentAlignment="Stretch">
        <StackPanel
            Padding="24,20,24,40"
            HorizontalAlignment="Stretch"
            Spacing="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="EditTitle"
                    FontSize="32"
                    FontWeight="SemiBold"
                    Text="编辑" />
                <Button
                    x:Name="ResetSimulationButton"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Click="ResetSimulation_Click"
                    Content="重置模拟数据" />
            </Grid>

            <InfoBar
                x:Name="SimulationOnlyInfoBar"
                IsClosable="False"
                IsOpen="False"
                Severity="Informational"
                Title="仅模拟" />

            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <StackPanel Spacing="12">
                    <TextBlock
                        x:Name="DiskSectionTitle"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="磁盘与分区" />
                    <ComboBox
                        x:Name="DiskSelector"
                        MinWidth="360"
                        HorizontalAlignment="Left"
                        SelectionChanged="DiskSelector_SelectionChanged" />
                    <Border
                        Padding="8"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <StackPanel
                            x:Name="PartitionBar"
                            Orientation="Horizontal"
                            Spacing="2" />
                    </Border>
                    <TextBlock
                        x:Name="SelectedPartitionInfo"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal">
                        <Button x:Name="ExtendButton" Margin="0,0,8,8" Click="Extend_Click" Content="扩展卷" />
                        <Button x:Name="ShrinkButton" Margin="0,0,8,8" Click="Shrink_Click" Content="压缩卷" />
                        <Button x:Name="DeletePartitionButton" Margin="0,0,8,8" Click="DeletePartition_Click" Content="删除卷" />
                        <Button x:Name="FormatButton" Margin="0,0,8,8" Click="Format_Click" Content="格式化" />
                        <Button x:Name="NewPartitionButton" Margin="0,0,8,8" Click="NewPartition_Click" Content="新建分区" />
                        <Button x:Name="InitializeButton" Margin="0,0,8,8" Click="Initialize_Click" Content="初始化磁盘" />
                        <Button x:Name="OfflineButton" Margin="0,0,8,8" Click="Offline_Click" Content="脱机 / 联机" />
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <StackPanel Spacing="12">
                    <TextBlock
                        x:Name="PoolSectionTitle"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="存储池与虚拟磁盘" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <ScrollViewer
                            Grid.Column="0"
                            MaxHeight="420"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="10">
                                <StackPanel x:Name="PoolTilesPanel" Spacing="10" />
                                <Border
                                    x:Name="NewPoolTile"
                                    Padding="12"
                                    AllowDrop="True"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource SystemControlHighlightListLowBrush}"
                                    BorderThickness="2"
                                    CornerRadius="4"
                                    DragOver="PoolTile_DragOver"
                                    Drop="NewPoolTile_Drop">
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="18" Glyph="&#xE710;" />
                                            <TextBlock
                                                x:Name="NewPoolTileTitle"
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Text="新建池（把磁盘拖到这里）" />
                                        </StackPanel>
                                        <StackPanel x:Name="StagedDisksPanel" Spacing="4" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    Padding="12"
                                    AllowDrop="True"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    DragOver="PoolTile_DragOver"
                                    Drop="PrimordialTile_Drop">
                                    <StackPanel Spacing="8">
                                        <TextBlock
                                            x:Name="PrimordialTileTitle"
                                            FontWeight="SemiBold"
                                            Text="可用磁盘（原始池）" />
                                        <ListView
                                            x:Name="PrimordialDiskList"
                                            CanDragItems="True"
                                            DragItemsStarting="PrimordialDiskList_DragItemsStarting"
                                            SelectionMode="None">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon FontSize="14" Glyph="&#xEDA2;" />
                                                        <TextBlock VerticalAlignment="Center" Text="{Binding}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <Border
                            Grid.Column="1"
                            Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <StackPanel Spacing="10">
                                <TextBlock
                                    x:Name="ParameterTitle"
                                    FontWeight="SemiBold"
                                    Text="创建参数" />
                                <TextBlock x:Name="PoolNameLabel" Text="池名称" />
                                <TextBox x:Name="PoolNameBox" PlaceholderText="Pool03" />
                                <TextBlock x:Name="VirtualDiskNameLabel" Text="虚拟磁盘名称" />
                                <TextBox x:Name="VirtualDiskNameBox" PlaceholderText="Pool03" />
                                <TextBlock x:Name="ResiliencyLabel" Text="复原类型" />
                                <ComboBox
                                    x:Name="ResiliencyBox"
                                    HorizontalAlignment="Stretch"
                                    SelectedIndex="0">
                                    <x:String>Simple</x:String>
                                    <x:String>Mirror</x:String>
                                    <x:String>Parity</x:String>
                                </ComboBox>
                                <TextBlock x:Name="InterleaveLabel" Text="交织大小" />
                                <ComboBox
                                    x:Name="InterleaveBox"
                                    HorizontalAlignment="Stretch"
                                    SelectedIndex="1">
                                    <x:String>32K</x:String>
                                    <x:String>64K</x:String>
                                    <x:String>128K</x:String>
                                    <x:String>256K</x:String>
                                </ComboBox>
                                <TextBlock x:Name="VirtualDiskSizeLabel" Text="虚拟磁盘大小 (GB，留空为最大)" />
                                <TextBox x:Name="VirtualDiskSizeBox" PlaceholderText="最大" />
                                <TextBlock x:Name="ClusterSizeLabel" Text="NTFS 簇大小" />
                                <ComboBox
                                    x:Name="ClusterSizeBox"
                                    HorizontalAlignment="Stretch"
                                    SelectedIndex="4">
                                    <x:String>4K</x:String>
                                    <x:String>8K</x:String>
                                    <x:String>16K</x:String>
                                    <x:String>32K</x:String>
                                    <x:String>64K</x:String>
                                </ComboBox>
                                <TextBlock
                                    x:Name="ResearchNote"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="本项目测试结论：64K 交织 + 64K 簇为当前安全推荐配置。"
                                    TextWrapping="Wrap" />
                                <Button
                                    x:Name="CreatePoolButton"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Stretch"
                                    Click="CreatePool_Click"
                                    Content="创建"
                                    Style="{ThemeResource AccentButtonStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
