<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinPool_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinPool_App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinPool_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <Grid Padding="12,4,12,12">
        <Grid.RowDefinitions>
            <RowDefinition MinHeight="250" Height="3*" />
            <RowDefinition Height="8" />
            <RowDefinition MinHeight="230" Height="2*" />
        </Grid.RowDefinitions>

        <Grid x:Name="BrushProbes" Width="0" Height="0" Visibility="Collapsed">
            <TextBlock x:Name="ProbeSecondaryText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Border x:Name="ProbeDivider" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Border x:Name="ProbeHover" Background="{ThemeResource ControlFillColorSecondaryBrush}" />
        </Grid>

        <InfoBar
            Grid.Row="0"
            Margin="20,12,20,0"
            VerticalAlignment="Top"
            Canvas.ZIndex="20"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.ShowInventoryStatus, Mode=OneWay}"
            Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            Severity="Informational" />

        <Border
            Grid.Row="0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <ScrollViewer
                x:Name="TopologyScrollViewer"
                Padding="8"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Enabled"
                SizeChanged="TopologyScrollViewer_SizeChanged"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto">
                <ItemsControl
                    x:Name="TopologySystemsControl"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.TopologySystems}">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:TopologyNodeControl
                                HorizontalAlignment="Stretch"
                                ViewModel="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <toolkit:GridSplitter
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Rows"
            Background="{ThemeResource CardStrokeColorDefaultBrush}"
            AutomationProperties.Name="Resize workspaces" />

        <Border
            Grid.Row="2"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition MinWidth="200" Width="Auto" />
                </Grid.ColumnDefinitions>

                <ListView
                    x:Name="VerticalCategoryList"
                    Grid.Column="0"
                    Padding="6"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0"
                    ItemsSource="{x:Bind ViewModel.Categories}"
                    SelectedItem="{x:Bind ViewModel.SelectedCategoryItem, Mode=TwoWay}"
                    SelectionMode="Single"
                    ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                    ScrollViewer.VerticalScrollBarVisibility="Hidden">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel
                                Padding="10,8"
                                Orientation="Horizontal"
                                Spacing="8">
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Glyph="{Binding Glyph}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Text="{Binding Title}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <ScrollViewer
                    x:Name="TableOuterScrollViewer"
                    Grid.Column="1"
                    Padding="8"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Enabled">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="LabelColumnGrid" Grid.Column="0" />
                        <ScrollViewer
                            x:Name="TableScrollViewer"
                            Grid.Column="1"
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Enabled"
                            VerticalScrollBarVisibility="Disabled"
                            VerticalScrollMode="Disabled">
                            <Grid
                                x:Name="ComparisonTableGrid"
                                PointerWheelChanged="ComparisonTableGrid_PointerWheelChanged" />
                        </ScrollViewer>
                    </Grid>
                </ScrollViewer>

                <toolkit:GridSplitter
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    ResizeBehavior="PreviousAndNext"
                    ResizeDirection="Columns"
                    Background="{ThemeResource CardStrokeColorDefaultBrush}"
                    AutomationProperties.Name="Resize table and command areas" />

                <ScrollViewer
                    Grid.Column="3"
                    Padding="12"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,0,0"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        x:Name="CommandButtonsPanel"
                        MinWidth="180"
                        Spacing="8" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
