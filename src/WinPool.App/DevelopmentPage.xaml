<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinPool_App.DevelopmentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <Grid
        x:Name="DevelopmentLayout"
        Padding="24"
        SizeChanged="DevelopmentLayout_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="UpperAreaRow" Height="2*" MinHeight="220" />
            <RowDefinition Height="8" />
            <RowDefinition x:Name="LowerAreaRow" Height="*" MinHeight="140" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="MessageListColumn" Width="1.2*" MinWidth="280" />
            <ColumnDefinition x:Name="TopColumnSplitterColumn" Width="8" />
            <ColumnDefinition x:Name="RightAreaColumn" Width="*" MinWidth="240" />
        </Grid.ColumnDefinitions>

        <Border
            x:Name="MessageListArea"
            Grid.Row="0"
            Grid.Column="0"
            Padding="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
                <Grid>
                    <ListView
                        x:Name="MessageList"
                        DoubleTapped="MessageList_DoubleTapped"
                        SelectionChanged="MessageList_SelectionChanged"
                        SelectionMode="Single"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.HorizontalScrollMode="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollMode="Enabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="36" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid
                                    x:Name="MessageRowVisual"
                                    MinHeight="40"
                                    PointerEntered="MessageRowVisual_PointerEntered"
                                    PointerExited="MessageRowVisual_PointerExited">
                                    <Border
                                        x:Name="MessageRowSelectedFill"
                                        Background="{StaticResource WinPoolAccentHoverBrush}"
                                        IsHitTestVisible="False"
                                        Opacity="0" />
                                    <Border
                                        x:Name="MessageRowHoverFill"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        IsHitTestVisible="False"
                                        Opacity="0" />
                                    <Border
                                        Padding="8,5"
                                        Background="Transparent"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1">
                                        <Grid ColumnSpacing="10" MinHeight="34">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                FontFamily="Consolas"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding CreatedAt}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                            <TextBlock
                                                Grid.Column="1"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Severity}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                            <TextBlock
                                                Grid.Column="2"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Source}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                            <TextBlock
                                                Grid.Column="3"
                                                FontSize="12"
                                                Text="{Binding Summary}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                        </Grid>
                                    </Border>
                                    <Border
                                        x:Name="MessageRowSelectionIndicator"
                                        Width="3"
                                        HorizontalAlignment="Left"
                                        Background="{StaticResource WinPoolAccentBrush}"
                                        IsHitTestVisible="False"
                                        Opacity="0" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        x:Name="EmptyMessageListText"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsHitTestVisible="False"
                        TextWrapping="Wrap" />
                </Grid>
            </Grid>
        </Border>

        <toolkit:GridSplitter
            x:Name="TopAreaColumnSplitter"
            Grid.Row="0"
            Grid.Column="1"
            HorizontalAlignment="Stretch"
            Background="{ThemeResource CardStrokeColorDefaultBrush}"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Columns" />

        <Border
            x:Name="RightTopEmptyArea"
            Grid.Row="0"
            Grid.Column="2"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4" />

        <toolkit:GridSplitter
            x:Name="TopBottomAreaSplitter"
            Grid.Row="1"
            Grid.ColumnSpan="3"
            HorizontalAlignment="Stretch"
            Background="{ThemeResource CardStrokeColorDefaultBrush}"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Rows" />

        <Border
            x:Name="LowerEmptyArea"
            Grid.Row="2"
            Grid.ColumnSpan="3"
            Padding="16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <TextBlock
                x:Name="AiEntryHint"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Border>

        <Grid
            x:Name="MessageDetailOverlay"
            Grid.RowSpan="3"
            Grid.ColumnSpan="3"
            Background="#80000000"
            Tapped="MessageDetailOverlay_Tapped"
            Visibility="Collapsed">
            <TextBox
                x:Name="MessageDetailText"
                Width="560"
                Height="180"
                MaxWidth="640"
                MaxHeight="380"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AcceptsReturn="True"
                IsReadOnly="True"
                IsSpellCheckEnabled="False"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Page>
