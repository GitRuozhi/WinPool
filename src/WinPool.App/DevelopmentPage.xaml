<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinPool_App.DevelopmentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <Grid Padding="32">
            <StackPanel
                MaxWidth="720"
                HorizontalAlignment="Left"
                Spacing="16">
                <TextBlock
                    FontSize="28"
                    FontWeight="SemiBold"
                    Text="开发者功能 / Developer features" />
                <InfoBar
                    IsClosable="False"
                    IsOpen="True"
                    Message="完整开发者与 AI Agent 工作区不属于 WinPool 1.x，计划作为 WinPool 2.0 功能推出。&#x0a;The complete developer and AI Agent workspace is outside WinPool 1.x and is planned for WinPool 2.0."
                    Severity="Informational"
                    Title="WinPool 2.0" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="WinPool 1.x 不提供开发诊断面板、自由命令界面或公共自动化契约。&#x0a;WinPool 1.x does not expose a developer diagnostics panel, a free-form command surface, or a public automation contract."
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
