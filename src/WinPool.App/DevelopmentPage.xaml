<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinPool_App.DevelopmentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinPool_App.Controls">
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ScrollViewer
            Grid.Row="0"
            MaxHeight="300"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="880"
                HorizontalAlignment="Stretch"
                Spacing="12">
                <TextBlock
                    x:Name="PageTitle"
                    FontSize="28"
                    FontWeight="SemiBold" />
                <TextBlock
                    x:Name="RoadmapTitle"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    x:Name="RoadmapText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />

                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <StackPanel Spacing="8">
                        <TextBlock
                            x:Name="DiagnosticsTitle"
                            FontSize="18"
                            FontWeight="SemiBold" />
                        <TextBlock
                            x:Name="DiagnosticsDescription"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <TextBox
                            x:Name="DiagnosticsPathText"
                            IsReadOnly="True"
                            IsSpellCheckEnabled="False"
                            TextWrapping="Wrap" />
                        <controls:ContextHelpHost HorizontalAlignment="Left">
                            <Button
                                x:Name="CopyDiagnosticsPathButton"
                                HorizontalAlignment="Left"
                                Click="CopyDiagnosticsPathButton_Click" />
                        </controls:ContextHelpHost>
                        <TextBlock
                            x:Name="DiagnosticsStatusText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <StackPanel Spacing="8">
                    <TextBlock
                        x:Name="SessionMessagesTitle"
                        FontSize="18"
                        FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="SessionMessagesDescription"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:ContextHelpHost Grid.Column="0">
                            <Button
                                x:Name="CopyAllMessagesButton"
                                Click="CopyAllMessagesButton_Click" />
                        </controls:ContextHelpHost>
                        <controls:ContextHelpHost Grid.Column="1">
                            <Button
                                x:Name="ClearMessagesButton"
                                Click="ClearMessagesButton_Click" />
                        </controls:ContextHelpHost>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ListView
                x:Name="MessageList"
                MinHeight="120"
                SelectionChanged="MessageList_SelectionChanged"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="8,6" Spacing="2">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding CreatedAt}" />
                                <TextBlock
                                    Grid.Column="1"
                                    FontWeight="SemiBold"
                                    Text="{Binding Title}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                MaxLines="1"
                                Text="{Binding Message}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border
                Grid.Row="1"
                Padding="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <StackPanel Spacing="8">
                    <TextBlock
                        x:Name="SelectedMessageTitle"
                        FontWeight="SemiBold" />
                    <TextBox
                        x:Name="SelectedMessageDetail"
                        AcceptsReturn="True"
                        Height="150"
                        IsReadOnly="True"
                        IsSpellCheckEnabled="False"
                        TextWrapping="Wrap" />
                    <controls:ContextHelpHost HorizontalAlignment="Left">
                        <Button
                            x:Name="CopySelectedMessageButton"
                            HorizontalAlignment="Left"
                            Click="CopySelectedMessageButton_Click" />
                    </controls:ContextHelpHost>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
