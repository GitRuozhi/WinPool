<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WinPool_App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinPool_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:core="using:WinPool.Core"
    Title="WinPool"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="CustomTitleBar"
            Grid.Row="0"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            Loaded="CustomTitleBar_Loaded"
            SizeChanged="CustomTitleBar_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Margin="14,0,20,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <Image Width="22" Height="22" Source="Assets/AppIcon.ico" />
                <TextBlock
                    x:Name="WindowTitleText"
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="WinPool" />
            </StackPanel>

            <ListView
                x:Name="ShellNavigationList"
                Grid.Column="1"
                VerticalAlignment="Center"
                ItemsSource="{x:Bind ShellNavigationItems}"
                SelectedItem="{x:Bind SelectedShellItem, Mode=TwoWay}"
                SelectionChanged="ShellNavigationList_SelectionChanged"
                SelectionMode="Single"
                ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                ScrollViewer.HorizontalScrollMode="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid
                            Width="{Binding ItemWidth}"
                            MinWidth="42"
                            Padding="10,0"
                            HorizontalAlignment="Center"
                            ToolTipService.ToolTip="{Binding Title}">
                            <StackPanel
                                HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="6">
                                <FontIcon FontSize="14" Glyph="{Binding Glyph}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="{Binding Title}"
                                    Visibility="{Binding TextVisibility}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border Grid.Column="2" Background="Transparent" />

            <StackPanel
                x:Name="ModeControls"
                Grid.Column="3"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <TextBlock
                    x:Name="SimulationModeLabel"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Text="模拟" />
                <ToggleSwitch
                    x:Name="ExecutionModeSwitch"
                    MinWidth="0"
                    VerticalAlignment="Center"
                    OffContent=""
                    OnContent=""
                    Toggled="ExecutionModeSwitch_Toggled"
                    AutomationProperties.Name="Execution mode" />
                <TextBlock
                    x:Name="RealModeLabel"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Text="真实" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Frame x:Name="RootFrame" />

            <ItemsControl
                x:Name="GlobalNotificationStack"
                Margin="12,6,12,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Canvas.ZIndex="100"
                ItemsSource="{x:Bind NotificationService.Notifications, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <InfoBar
                            IsClosable="True"
                            IsOpen="True"
                            CloseButtonClick="GlobalNotification_CloseButtonClick"
                            Message="{Binding Message}"
                            Severity="{Binding Severity, Converter={StaticResource NotificationSeverityConverter}}"
                            Title="{Binding Title}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</Window>
