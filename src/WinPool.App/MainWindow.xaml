<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WinPool_App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:WinPool_App.Controls"
    xmlns:local="using:WinPool_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="WinPool"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="CustomTitleBar"
            Grid.Row="0"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            Loaded="CustomTitleBar_Loaded"
            SizeChanged="CustomTitleBar_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Margin="14,0,20,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <Image Width="22" Height="22" Source="Assets/CAppIcon.ico" />
                <TextBlock
                    x:Name="WindowTitleText"
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="WinPool" />
            </StackPanel>

            <ListView
                x:Name="ShellNavigationList"
                Grid.Column="1"
                VerticalAlignment="Center"
                ItemsSource="{x:Bind ShellNavigationItems}"
                SelectedItem="{x:Bind SelectedShellItem, Mode=TwoWay}"
                SelectionChanged="ShellNavigationList_SelectionChanged"
                SelectionMode="Single"
                ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                ScrollViewer.HorizontalScrollMode="Disabled"
                Loaded="TitleBarInteractiveElement_Loaded"
                SizeChanged="TitleBarInteractiveElement_SizeChanged">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid
                            Width="{Binding ItemWidth}"
                            MinWidth="42"
                            Padding="10,0"
                            HorizontalAlignment="Center"
                            Background="{Binding Background}"
                            ToolTipService.ToolTip="{Binding Title}">
                            <StackPanel
                                HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="6">
                                <FontIcon
                                    FontSize="14"
                                    Foreground="{Binding Foreground}"
                                    Glyph="{Binding Glyph}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground}"
                                    Text="{Binding Title}"
                                    Visibility="{Binding TextVisibility}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border
                x:Name="ActiveSystemSelectorHost"
                Grid.Column="2"
                Margin="24,0,12,0"
                MinWidth="180"
                MaxWidth="280"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="1"
                Loaded="TitleBarInteractiveElement_Loaded"
                SizeChanged="TitleBarInteractiveElement_SizeChanged"
                CornerRadius="4"
                PointerEntered="ActiveSystemSelectorHost_PointerEntered"
                PointerExited="ActiveSystemSelectorHost_PointerExited">
                <ComboBox
                    x:Name="ActiveSystemSelector"
                    Width="260"
                    MinWidth="178"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalContentAlignment="Left"
                    AutomationProperties.Name="Storage system"
                    DropDownClosed="ActiveSystemSelector_DropDownClosed"
                    SelectionChanged="ActiveSystemSelector_SelectionChanged"
                    Loaded="TitleBarInteractiveElement_Loaded"
                    SizeChanged="TitleBarInteractiveElement_SizeChanged"
                    Visibility="Collapsed">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>
            </Border>

            <StackPanel
                x:Name="ModeControls"
                Grid.Column="3"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8"
                Loaded="TitleBarInteractiveElement_Loaded"
                SizeChanged="TitleBarInteractiveElement_SizeChanged">
                <TextBlock
                    x:Name="LocalRealOperationsLabel"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Text="真实编辑" />
                <ToggleSwitch
                    x:Name="LocalRealOperationsSwitch"
                    MinWidth="0"
                    VerticalAlignment="Center"
                    OffContent=""
                    OnContent=""
                    Toggled="LocalRealOperationsSwitch_Toggled"
                    AutomationProperties.Name="Real editing" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Frame x:Name="RootFrame" />

            <StackPanel
                x:Name="GlobalNotificationHost"
                Margin="12,0,12,12"
                MaxWidth="400"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Canvas.ZIndex="100"
                Spacing="6">
                <ItemsControl
                    x:Name="GlobalNotificationStack"
                    ItemsSource="{x:Bind VisibleNotifications, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:NotificationCard
                                ExitAnimationCompleted="NotificationCard_ExitAnimationCompleted"
                                IsChinese="{Binding IsChinese}"
                                IsDismissing="{Binding IsDismissing}"
                                Invoked="NotificationCard_Invoked"
                                Notification="{Binding Notification}"
                                />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
