<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinPool_App.Controls.TopologyNodeControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinPool_App.Controls"
    xmlns:shapes="using:Microsoft.UI.Xaml.Shapes"
    AutomationProperties.Name="{x:Bind ViewModel.Unit.DisplayName, Mode=OneWay}"
    GotFocus="TopologyNodeControl_GotFocus"
    IsTabStop="{x:Bind ViewModel.IsSelectable, Mode=OneWay}"
    KeyDown="TopologyNodeControl_KeyDown"
    LostFocus="TopologyNodeControl_LostFocus"
    PointerEntered="TopologyNodeControl_PointerEntered"
    PointerExited="TopologyNodeControl_PointerExited">

    <!-- Keep the whole card a pointer surface, including empty header space. -->
    <Grid x:Name="NodeSurface" Width="{x:Bind ViewModel.PreferredWidth, Mode=OneWay}" Background="Transparent" SizeChanged="NodeSurface_SizeChanged">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="InteractionStates">
                <VisualState x:Name="Normal">
                    <VisualState.Setters>
                        <Setter Target="NodeBorder.Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
                        <Setter Target="NodeBorder.BorderBrush" Value="{ThemeResource WinPoolTopologyRestStrokeBrush}" />
                        <Setter Target="InteractionBorder.Visibility" Value="Collapsed" />
                        <Setter Target="DisplayNameText.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                        <Setter Target="TypeLabelText.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Setter Target="SummaryText.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                        <Setter Target="NodeBorder.Background" Value="{ThemeResource WinPoolAccentHoverBrush}" />
                        <Setter Target="InteractionBorder.BorderBrush" Value="{ThemeResource WinPoolAccentBorderBrush}" />
                        <Setter Target="InteractionBorder.Visibility" Value="Visible" />
                        <Setter Target="DisplayNameText.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                        <Setter Target="TypeLabelText.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                        <Setter Target="SummaryText.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Selected">
                    <VisualState.Setters>
                        <Setter Target="NodeBorder.Background" Value="{ThemeResource WinPoolAccentBrush}" />
                        <Setter Target="InteractionBorder.BorderBrush" Value="{ThemeResource WinPoolAccentBorderBrush}" />
                        <Setter Target="InteractionBorder.Visibility" Value="Visible" />
                        <Setter Target="DisplayNameText.Foreground" Value="{ThemeResource WinPoolAccentForegroundBrush}" />
                        <Setter Target="TypeLabelText.Foreground" Value="{ThemeResource WinPoolAccentForegroundBrush}" />
                        <Setter Target="SummaryText.Foreground" Value="{ThemeResource WinPoolAccentForegroundBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Border
            x:Name="NodeBorder"
            MinHeight="{x:Bind ViewModel.MinimumCardHeight, Mode=OneWay}"
            Margin="0"
            Padding="6"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource WinPoolTopologyRestStrokeBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Tapped="NodeBorder_Tapped"
            RightTapped="NodeBorder_RightTapped">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid
                Grid.Row="{x:Bind ViewModel.HeaderRow, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HeaderVisibility, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:ContextHelpHost Grid.Column="0">
                    <Button
                        x:Name="ExpandButton"
                        Style="{StaticResource WinPoolInlineIconButtonStyle}"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{x:Bind ViewModel.ToggleExpandedCommand, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.HasChildren, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ExpandButtonVisibility, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.ExpandAutomationName, Mode=OneWay}"
                        Tapped="ExpandButton_Tapped">
                        <FontIcon x:Name="ExpandIcon" FontSize="12" Glyph="{x:Bind ViewModel.ExpandGlyph, Mode=OneWay}" />
                    </Button>
                </controls:ContextHelpHost>
                <Grid
                    Grid.Column="1"
                    Padding="8,4">
                    <StackPanel
                        IsHitTestVisible="False"
                        MinHeight="42"
                        Visibility="{x:Bind ViewModel.MultiLineHeaderVisibility, Mode=OneWay}">
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="DisplayNameText"
                                MinHeight="18"
                                Margin="0,0,10,0"
                                FontWeight="SemiBold"
                                Text="{x:Bind ViewModel.Unit.DisplayName, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <Border
                                Grid.Column="1"
                                Padding="5,1"
                                Background="{StaticResource WinPoolAccentBrush}"
                                CornerRadius="3"
                                Visibility="{x:Bind ViewModel.BadgeVisibility, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <FontIcon
                                        FontSize="10"
                                        Foreground="{StaticResource WinPoolAccentForegroundBrush}"
                                        Glyph="&#xE7BA;" />
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{StaticResource WinPoolAccentForegroundBrush}"
                                        Text="{x:Bind ViewModel.BadgeText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid Margin="0,2,0,0" ColumnSpacing="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <FontIcon
                                x:Name="TypeIcon"
                                Grid.Column="0"
                                Margin="0,1,0,0"
                                VerticalAlignment="Top"
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="{x:Bind ViewModel.TypeGlyph, Mode=OneWay}" />
                            <Grid
                                x:Name="WindowsMarker"
                                Grid.Column="1"
                                Width="12"
                                Height="12"
                                Margin="0,3,0,0"
                                VerticalAlignment="Top"
                                ColumnSpacing="1.5"
                                RowSpacing="1.5"
                                Visibility="{x:Bind ViewModel.WindowsMarkerVisibility, Mode=OneWay}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle x:Name="WindowsMarkerSquare1" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Rectangle x:Name="WindowsMarkerSquare2" Grid.Column="1" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Rectangle x:Name="WindowsMarkerSquare3" Grid.Row="1" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Rectangle x:Name="WindowsMarkerSquare4" Grid.Row="1" Grid.Column="1" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <TextBlock
                                x:Name="TypeLabelText"
                                Grid.Column="2"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.TypeLabel, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="SummaryText"
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Margin="0,2,0,0"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.Summary, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                    <Grid
                        IsHitTestVisible="False"
                        ColumnSpacing="6"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.SingleLineHeaderVisibility, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            x:Name="SingleLineTypeIcon"
                            Grid.Column="0"
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="{x:Bind ViewModel.TypeGlyph, Mode=OneWay}" />
                        <Grid
                            x:Name="SingleLineWindowsMarker"
                            Grid.Column="1"
                            Width="12"
                            Height="12"
                            ColumnSpacing="1.5"
                            RowSpacing="1.5"
                            Visibility="{x:Bind ViewModel.WindowsMarkerVisibility, Mode=OneWay}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle x:Name="SingleLineWindowsSquare1" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Rectangle x:Name="SingleLineWindowsSquare2" Grid.Column="1" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Rectangle x:Name="SingleLineWindowsSquare3" Grid.Row="1" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Rectangle x:Name="SingleLineWindowsSquare4" Grid.Row="1" Grid.Column="1" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <TextBlock
                            x:Name="SingleLineDisplayNameText"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            TextWrapping="NoWrap"
                            Text="{x:Bind ViewModel.Unit.DisplayName, Mode=OneWay}" />
                        <TextBlock
                            x:Name="SingleLineSummaryText"
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            Text="{x:Bind ViewModel.SingleLineHeaderText, Mode=OneWay}" />
                        <Border
                            Grid.Column="4"
                            Padding="5,1"
                            Background="{StaticResource WinPoolAccentBrush}"
                            CornerRadius="3"
                            Visibility="{x:Bind ViewModel.BadgeVisibility, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <FontIcon
                                    FontSize="10"
                                    Foreground="{StaticResource WinPoolAccentForegroundBrush}"
                                    Glyph="&#xE7BA;" />
                                <TextBlock
                                    FontSize="10"
                                    Foreground="{StaticResource WinPoolAccentForegroundBrush}"
                                    Text="{x:Bind ViewModel.BadgeText, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

                <ItemsControl
                    x:Name="FlowChildren"
                    Grid.Row="{x:Bind ViewModel.ChildrenRow, Mode=OneWay}"
                    Margin="6,5,6,0"
                    ItemsSource="{x:Bind ViewModel.Children, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.FlowChildrenVisibility, Mode=OneWay}">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:AdaptiveFlowPanel
                            HorizontalAlignment="Stretch"
                            />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:TopologyNodeControl ViewModel="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

                <ItemsControl
                    x:Name="WeightedChildren"
                    Grid.Row="{x:Bind ViewModel.ChildrenRow, Mode=OneWay}"
                    Margin="6,5,6,0"
                    ItemsSource="{x:Bind ViewModel.Children, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.WeightedChildrenVisibility, Mode=OneWay}">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:WeightedPoolPanel HorizontalAlignment="Stretch" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:TopologyNodeControl ViewModel="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

                <ItemsControl
                    x:Name="StackChildren"
                    Grid.Row="{x:Bind ViewModel.ChildrenRow, Mode=OneWay}"
                    Margin="6,5,6,0"
                    ItemsSource="{x:Bind ViewModel.Children, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.StackChildrenVisibility, Mode=OneWay}">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:SurfaceStackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:TopologyNodeControl ViewModel="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Overlay, not a title column: 112 DIP disks keep their name width. -->
            <StackPanel
                Grid.RowSpan="2"
                Margin="0,6,6,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Spacing="6"
                IsHitTestVisible="False">
                <shapes:Ellipse
                    x:Name="PendingMark"
                    Width="6"
                    Height="6"
                    Margin="0,2,0,0"
                    HorizontalAlignment="Center"
                    Fill="{StaticResource WinPoolAccentBrush}"
                    Visibility="{x:Bind ViewModel.PendingModificationVisibility, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind ViewModel.PendingModificationName, Mode=OneWay}" />
                <FontIcon
                    x:Name="CannotLeaveMark"
                    FontSize="12"
                    Glyph="&#xE840;"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Visibility="{x:Bind ViewModel.CannotLeaveVisibility, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind ViewModel.CannotLeaveName, Mode=OneWay}" />
                <FontIcon
                    x:Name="StoredDataMark"
                    FontSize="12"
                    Glyph="&#xED43;"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Visibility="{x:Bind ViewModel.HasStoredDataVisibility, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind ViewModel.HasStoredDataName, Mode=OneWay}" />
            </StackPanel>

            </Grid>
        </Border>

        <Canvas
            x:Name="UnavailableOverlay"
            IsHitTestVisible="False"
            Visibility="{x:Bind ViewModel.UnavailableVisibility, Mode=OneWay}"
            AutomationProperties.Name="{x:Bind ViewModel.UnavailableName, Mode=OneWay}">
            <Border
                x:Name="UnavailableOverlaySurface"
                Background="#80000000"
                CornerRadius="4">
                <Grid>
                    <Canvas x:Name="UnavailableChainCanvas" IsHitTestVisible="False" />
                    <StackPanel
                        x:Name="UnavailableStatusPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="12"
                        Spacing="8"
                        IsHitTestVisible="False">
                        <Image
                            x:Name="UnavailableIconImage"
                            Width="52"
                            Height="52"
                            HorizontalAlignment="Center"
                            Stretch="Uniform" />
                        <TextBlock
                            x:Name="UnavailableStatusText"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="300"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="{x:Bind ViewModel.UnavailableName, Mode=OneWay}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </Canvas>
        <Border
            x:Name="InteractionBorder"
            BorderBrush="{ThemeResource WinPoolAccentBorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            IsHitTestVisible="False"
            Visibility="Collapsed" />
        <!-- Pending segments share the same one-DIP edge and stay visible
             while the card retains its hover/selection background. -->
        <shapes:Rectangle
            x:Name="PendingRestOutline"
            Margin="0.5"
            RadiusX="4"
            RadiusY="4"
            Stroke="{ThemeResource WinPoolTopologyRestStrokeBrush}"
            StrokeThickness="1"
            IsHitTestVisible="False"
            Visibility="{x:Bind ViewModel.PendingModificationVisibility, Mode=OneWay}" />
        <shapes:Rectangle
            x:Name="PendingOutline"
            Margin="0.5"
            RadiusX="4"
            RadiusY="4"
            Stroke="{ThemeResource WinPoolAccentBrush}"
            StrokeThickness="1"
            IsHitTestVisible="False"
            Visibility="{x:Bind ViewModel.PendingModificationVisibility, Mode=OneWay}"
            AutomationProperties.Name="{x:Bind ViewModel.PendingModificationName, Mode=OneWay}" />
        <Border
            x:Name="DropTargetBorder"
            BorderBrush="{ThemeResource WinPoolAccentBorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            IsHitTestVisible="False"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
