<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinPool_App.Controls.NotificationCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="384"
    Height="128"
    IsTabStop="True"
    KeyDown="NotificationCard_KeyDown"
    Tapped="NotificationCard_Tapped">
    <UserControl.Clip>
        <RectangleGeometry Rect="0,0,384,128" />
    </UserControl.Clip>
    <UserControl.RenderTransform>
        <TranslateTransform x:Name="NotificationCardTranslation" />
    </UserControl.RenderTransform>
    <UserControl.Resources>
        <Storyboard x:Name="DismissStoryboard" Completed="DismissStoryboard_Completed">
            <DoubleAnimation
                Storyboard.TargetName="NotificationCardTranslation"
                Storyboard.TargetProperty="X"
                To="420"
                Duration="0:0:0.24" />
        </Storyboard>
    </UserControl.Resources>
    <Border
        Padding="0"
        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="4">
        <InfoBar
            x:Name="NotificationInfoBar"
            Background="Transparent"
            BorderThickness="0"
            IsClosable="False"
            IsOpen="True" />
    </Border>
</UserControl>
