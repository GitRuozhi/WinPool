<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinPool_App.Controls.NotificationCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    GotFocus="NotificationCard_GotFocus"
    LostFocus="NotificationCard_LostFocus"
    PointerEntered="NotificationCard_PointerEntered"
    PointerExited="NotificationCard_PointerExited">
    <Border
        x:Name="CardBorder"
        Padding="0"
        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="4">
        <StackPanel Spacing="2">
            <InfoBar
                x:Name="NotificationInfoBar"
                Background="Transparent"
                BorderThickness="0"
                IsClosable="False"
                IsOpen="True" />
            <Grid Margin="12,0,12,8" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="OccurrenceText"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button
                        x:Name="DetailsButton"
                        MinWidth="0"
                        Padding="8,3"
                        Click="DetailsButton_Click">
                        <TextBlock x:Name="DetailsButtonText" />
                    </Button>
                    <Button
                        x:Name="CloseButton"
                        MinWidth="0"
                        Padding="8,3"
                        Click="CloseButton_Click">
                        <TextBlock x:Name="CloseButtonText" />
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
