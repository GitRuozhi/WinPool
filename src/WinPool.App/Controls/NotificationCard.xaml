<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinPool_App.Controls.NotificationCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="384"
    MinHeight="72"
    MaxHeight="200"
    IsTabStop="True"
    KeyDown="NotificationCard_KeyDown"
    Tapped="NotificationCard_Tapped">
    <UserControl.RenderTransform>
        <TranslateTransform x:Name="NotificationCardTranslation" />
    </UserControl.RenderTransform>
    <UserControl.Resources>
        <Storyboard x:Name="DismissStoryboard" Completed="DismissStoryboard_Completed">
            <DoubleAnimation
                Storyboard.TargetName="NotificationCardTranslation"
                Storyboard.TargetProperty="X"
                To="420"
                Duration="0:0:0.24" />
        </Storyboard>
    </UserControl.Resources>
    <InfoBar
        x:Name="NotificationInfoBar"
        IsClosable="False"
        IsOpen="True" />
</UserControl>
