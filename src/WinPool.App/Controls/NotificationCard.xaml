<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinPool_App.Controls.NotificationCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark"
    Width="384"
    MaxHeight="200"
    IsTabStop="True"
    KeyDown="NotificationCard_KeyDown"
    Tapped="NotificationCard_Tapped">
    <UserControl.RenderTransform>
        <TranslateTransform x:Name="NotificationCardTranslation" />
    </UserControl.RenderTransform>
    <UserControl.Resources>
        <Storyboard x:Name="DismissStoryboard" Completed="DismissStoryboard_Completed">
            <DoubleAnimation
                Storyboard.TargetName="NotificationCardTranslation"
                Storyboard.TargetProperty="X"
                To="420"
                Duration="0:0:0.24" />
        </Storyboard>
    </UserControl.Resources>
    <Grid>
        <InfoBar
            x:Name="NotificationInfoBar"
            Background="#C0000000"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            IsClosable="False"
            IsIconVisible="True"
            IsOpen="True" />

        <Border
            x:Name="ProgressSurface"
            Padding="12"
            Background="#C0000000"
            Style="{StaticResource WinPoolCardBorderStyle}"
            Visibility="Collapsed">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ProgressRing
                    x:Name="ProgressRing"
                    Width="20"
                    Height="20"
                    IsActive="False"
                    VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock
                        x:Name="ProgressTitle"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="ProgressMessage"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
