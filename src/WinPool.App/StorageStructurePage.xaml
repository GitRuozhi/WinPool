<?xml version="1.0" encoding="utf-8"?>
<editors:EditorPageBase
    x:Class="WinPool_App.StorageStructurePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinPool_App.Controls"
    xmlns:editors="using:WinPool_App"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel
            x:Name="NarrowPageNavigation"
            Orientation="Horizontal"
            Spacing="8"
            Margin="0,0,0,8"
            Visibility="Collapsed">
            <Button x:Name="ShowTargetsButton" Click="ShowTargets_Click" />
            <Button x:Name="ShowPropertiesButton" Click="ShowProperties_Click" />
        </StackPanel>
        <Grid x:Name="EditorLayoutGrid" Grid.Row="1"
              SizeChanged="EditorLayoutGrid_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="TargetsColumn" Width="*" MinWidth="120" />
            <ColumnDefinition x:Name="SplitterColumn" Width="8" />
            <ColumnDefinition x:Name="PropertiesColumn" Width="320" MinWidth="240" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border
            x:Name="TopologyBorder"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
            <ScrollViewer
                x:Name="TopologyScrollViewer"
                Padding="12"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Enabled"
                SizeChanged="TopologyScrollViewer_SizeChanged"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl
                    x:Name="TopologyControl"
                    HorizontalAlignment="Stretch">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:TopologyNodeControl
                                HorizontalAlignment="Stretch"
                                ViewModel="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            </Grid>
        </Border>
        <Border
            x:Name="PendingActionsBorder"
            Grid.Row="1"
            Margin="0,8,0,0"
            Padding="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <StackPanel Spacing="8">
                <TextBlock x:Name="PendingActionsTitle" FontWeight="SemiBold" />
                <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PendingActionsPanel" Spacing="4">
                        <TextBlock x:Name="PendingActionsEmptyText" />
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>
        <Border
            x:Name="StructureChromeBorder"
            Grid.Row="2"
            Margin="0,8,0,0"
            Padding="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid x:Name="StructureActionsPanel" ColumnSpacing="8" RowSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="Auto" MinHeight="40" />
                </Grid.RowDefinitions>
                <controls:ContextHelpHost Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="UndoButton" Width="32" MinWidth="32" Height="32" Padding="0" Style="{StaticResource WinPoolButtonBaseStyle}" Click="Undo_Click">
                        <FontIcon Glyph="&#xE7A7;" FontSize="14" />
                    </Button>
                </controls:ContextHelpHost>
                <controls:ContextHelpHost Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="RedoButton" Width="32" MinWidth="32" Height="32" Padding="0" Style="{StaticResource WinPoolButtonBaseStyle}" Click="Redo_Click">
                        <FontIcon Glyph="&#xE7A6;" FontSize="14" />
                    </Button>
                </controls:ContextHelpHost>
                <controls:ContextHelpHost Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="DiscardAllButton" Width="32" MinWidth="32" Height="32" Padding="0" Style="{StaticResource WinPoolButtonBaseStyle}" Click="DiscardAll_Click">
                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                    </Button>
                </controls:ContextHelpHost>
                <controls:ContextHelpHost Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="ApplyAllButton" Width="32" MinWidth="32" Height="32" Padding="0" Style="{StaticResource WinPoolButtonBaseStyle}" Click="ApplyAll_Click">
                        <FontIcon Glyph="&#xE73E;" FontSize="14" />
                    </Button>
                </controls:ContextHelpHost>
                <controls:ContextHelpHost Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">
                    <Button x:Name="DissolveButton" MinHeight="32" HorizontalAlignment="Stretch" Style="{StaticResource WinPoolButtonBaseStyle}" Click="Dissolve_Click">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="DissolveButtonIcon" Glyph="&#xE74D;" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" x:Name="DissolveButtonLabel" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </Grid>
                    </Button>
                </controls:ContextHelpHost>
                <controls:ContextHelpHost Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                    <Button x:Name="CreateVdiskButton" MinHeight="32" HorizontalAlignment="Stretch" Style="{StaticResource WinPoolButtonBaseStyle}" Click="VirtualDiskAction_Click">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="CreateVdiskButtonIcon" Glyph="&#xE710;" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" x:Name="CreateVdiskButtonLabel" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </Grid>
                    </Button>
                </controls:ContextHelpHost>
                <controls:ContextHelpHost Grid.Row="1" Grid.Column="2" VerticalAlignment="Center">
                    <Button x:Name="RetireButton" MinHeight="32" HorizontalAlignment="Stretch" Style="{StaticResource WinPoolButtonBaseStyle}" Click="Retire_Click">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="RetireButtonIcon" Glyph="&#xE7E8;" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" x:Name="RetireButtonLabel" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </Grid>
                    </Button>
                </controls:ContextHelpHost>
                <controls:ContextHelpHost Grid.Row="1" Grid.Column="3" VerticalAlignment="Center">
                    <Button x:Name="HotSpareButton" MinHeight="32" HorizontalAlignment="Stretch" Style="{StaticResource WinPoolButtonBaseStyle}" Click="HotSpare_Click">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="HotSpareButtonIcon" Glyph="&#xE72C;" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" x:Name="HotSpareButtonLabel" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </Grid>
                    </Button>
                </controls:ContextHelpHost>
            </Grid>
        </Border>
        <toolkit:GridSplitter
            x:Name="EditorSplitter"
            Grid.Column="1"
            Grid.RowSpan="3"
            HorizontalAlignment="Stretch"
            Background="{ThemeResource CardStrokeColorDefaultBrush}"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Columns"
            AutomationProperties.Name="Resize topology and properties" />
        <Grid
            x:Name="PropertiesPane"
            Grid.Column="2"
            Grid.RowSpan="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer
                VerticalAlignment="Stretch"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled">
                <StackPanel
                    x:Name="PoolSectionsPanel"
                    Spacing="{StaticResource WinPoolCardGap}">
                    <Border Style="{StaticResource WinPoolCardBorderStyle}">
                        <Grid
                            x:Name="PoolFormGrid"
                            Margin="12"
                            ColumnSpacing="4"
                            RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </Border>
                    <Border
                        x:Name="DiskAndPartitionCard"
                        Style="{StaticResource WinPoolCardBorderStyle}">
                        <Grid
                            x:Name="DiskAndPartitionFormGrid"
                            Margin="12"
                            ColumnSpacing="4"
                            RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <controls:ContextHelpHost Grid.Row="1" Margin="0,8,0,0">
                <Button
                    x:Name="SavePoolPropertiesButton"
                    Style="{StaticResource WinPoolButtonBaseStyle}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Click="SavePoolProperties_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                        <TextBlock x:Name="SavePoolPropertiesButtonLabel" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </controls:ContextHelpHost>
        </Grid>
        </Grid>
        <Border
            x:Name="RealTopologyOverlay"
            Grid.RowSpan="2"
            Background="#B3000000"
            Visibility="Collapsed">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Margin="16"
                MaxWidth="520">
                <ProgressRing
                    x:Name="RealTopologyProgress"
                    IsActive="False"
                    Width="72"
                    Height="72"
                    HorizontalAlignment="Center" />
                <TextBlock
                    x:Name="RealTopologyPhase"
                    Foreground="White"
                    TextWrapping="Wrap"
                    TextAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</editors:EditorPageBase>
