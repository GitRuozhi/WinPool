<?xml version="1.0" encoding="utf-8"?>
<editors:EditorPageBase
    x:Class="WinPool_App.StorageStructurePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinPool_App.Controls"
    xmlns:editors="using:WinPool_App"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <Grid Margin="8,0,8,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel
            x:Name="NarrowPageNavigation"
            Orientation="Horizontal"
            Spacing="8"
            Margin="0,0,0,6"
            Visibility="Collapsed">
            <Button x:Name="ShowTargetsButton" Click="ShowTargets_Click" />
            <Button x:Name="ShowPropertiesButton" Click="ShowProperties_Click" />
        </StackPanel>
        <Grid x:Name="EditorLayoutGrid" Grid.Row="1"
              SizeChanged="EditorLayoutGrid_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="TargetsColumn" Width="*" MinWidth="120" />
            <ColumnDefinition x:Name="SplitterColumn" Width="8" />
            <ColumnDefinition x:Name="PropertiesColumn" Width="320" MinWidth="240" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border
            x:Name="TopologyBorder"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
            <ScrollViewer
                x:Name="TopologyScrollViewer"
                Padding="12"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Enabled"
                SizeChanged="TopologyScrollViewer_SizeChanged"
                VerticalScrollBarVisibility="Auto">
                <ContentControl
                    x:Name="TopologyControl"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch" />
            </ScrollViewer>
            </Grid>
        </Border>
        <Border x:Name="StructureChromeBorder" Grid.Row="1" Margin="0,6,0,0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12">
            <controls:StructureActionsFlowPanel x:Name="StructureActionsPanel" Spacing="8">
                <controls:ContextHelpHost>
                    <Grid x:Name="PendingButtonHost">
                    <Button x:Name="PendingActionsButton" MinHeight="32" Style="{StaticResource WinPoolButtonBaseStyle}" Click="PendingActions_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="PendingActionsButtonIcon" Glyph="&#xE14C;" FontSize="14" />
                            <TextBlock x:Name="PendingActionsButtonLabel" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                        <Rectangle x:Name="PendingDefaultOutline" Stroke="{ThemeResource CardStrokeColorDefaultBrush}" StrokeThickness="1" Fill="Transparent" IsHitTestVisible="False" Margin="0.5" RadiusX="4" RadiusY="4" Visibility="Collapsed" />
                        <Rectangle x:Name="PendingThemeOutline" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="1" Fill="Transparent" IsHitTestVisible="False" Margin="0.5" RadiusX="4" RadiusY="4" Visibility="Collapsed" />
                    </Grid>
                </controls:ContextHelpHost>
                <controls:ContextHelpHost>
                    <Button x:Name="UndoButton" Width="32" MinWidth="32" Height="32" Padding="0" Style="{StaticResource WinPoolButtonBaseStyle}" Click="Undo_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="UndoButtonIcon" Glyph="&#xE7A7;" FontSize="14" />
                            <TextBlock x:Name="UndoButtonLabel" Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                </controls:ContextHelpHost>
                <controls:ContextHelpHost>
                    <Button x:Name="RedoButton" Width="32" MinWidth="32" Height="32" Padding="0" Style="{StaticResource WinPoolButtonBaseStyle}" Click="Redo_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="RedoButtonIcon" Glyph="&#xE7A6;" FontSize="14" />
                            <TextBlock x:Name="RedoButtonLabel" Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                </controls:ContextHelpHost>
                <controls:ContextHelpHost>
                    <Button x:Name="DiscardAllButton" Width="32" MinWidth="32" Height="32" Padding="0" Style="{StaticResource WinPoolButtonBaseStyle}" Click="DiscardAll_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="DiscardAllButtonIcon" Glyph="&#xE711;" FontSize="14" />
                            <TextBlock x:Name="DiscardButtonLabel" Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                </controls:ContextHelpHost>
                <controls:ContextHelpHost>
                    <Grid x:Name="ApplyButtonHost">
                    <Button x:Name="ApplyAllButton" Width="32" MinWidth="32" Height="32" Padding="0" Style="{StaticResource WinPoolButtonBaseStyle}" Click="ApplyAll_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="ApplyAllButtonIcon" Glyph="&#xE73E;" FontSize="14" />
                            <TextBlock x:Name="ApplyButtonLabel" Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                        <Rectangle x:Name="ApplyDefaultOutline" Stroke="{ThemeResource CardStrokeColorDefaultBrush}" StrokeThickness="1" Fill="Transparent" IsHitTestVisible="False" Margin="0.5" RadiusX="4" RadiusY="4" Visibility="Collapsed" />
                        <Rectangle x:Name="ApplyThemeOutline" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="1" Fill="Transparent" IsHitTestVisible="False" Margin="0.5" RadiusX="4" RadiusY="4" Visibility="Collapsed" />
                    </Grid>
                </controls:ContextHelpHost>
                <controls:ContextHelpHost>
                    <Button x:Name="PoolActionButton" MinHeight="32" Style="{StaticResource WinPoolButtonBaseStyle}" Click="PoolAction_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="PoolActionButtonIcon" Glyph="&#xE710;" FontSize="14" />
                            <TextBlock x:Name="PoolActionButtonLabel" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                </controls:ContextHelpHost>
                <controls:ContextHelpHost>
                    <Button x:Name="CreateVdiskButton" MinHeight="32" Style="{StaticResource WinPoolButtonBaseStyle}" Click="VirtualDiskAction_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="CreateVdiskButtonIcon" Glyph="&#xE710;" FontSize="14" />
                            <TextBlock x:Name="CreateVdiskButtonLabel" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                </controls:ContextHelpHost>
                <controls:ContextHelpHost>
                    <Button x:Name="RetireButton" MinHeight="32" Style="{StaticResource WinPoolButtonBaseStyle}" Click="Retire_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="RetireButtonIcon" Glyph="&#xE7E8;" FontSize="14" />
                            <TextBlock x:Name="RetireButtonLabel" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                </controls:ContextHelpHost>
                <controls:ContextHelpHost>
                    <Button x:Name="HotSpareButton" MinHeight="32" Style="{StaticResource WinPoolButtonBaseStyle}" Click="HotSpare_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="HotSpareButtonIcon" Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock x:Name="HotSpareButtonLabel" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                </controls:ContextHelpHost>
            </controls:StructureActionsFlowPanel>
            </ScrollViewer>
        </Border>
        <toolkit:GridSplitter
            x:Name="EditorSplitter"
            Grid.Column="1"
            Grid.RowSpan="3"
            HorizontalAlignment="Stretch"
            Background="{ThemeResource CardStrokeColorDefaultBrush}"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Columns"
            AutomationProperties.Name="Resize topology and properties" />
        <Grid
            x:Name="PropertiesPane"
            Grid.Column="2"
            Grid.RowSpan="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer
                x:Name="PropertiesScrollViewer"
                VerticalAlignment="Stretch"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled">
                <StackPanel
                    x:Name="PoolSectionsPanel"
                    Spacing="{StaticResource WinPoolCardGap}">
                    <Border Style="{StaticResource WinPoolCardBorderStyle}" Padding="12">
                        <Grid
                            x:Name="PoolFormGrid"
                            Margin="0"
                            ColumnSpacing="4"
                            RowSpacing="4">
                        </Grid>
                    </Border>
                    <Border
                        x:Name="DiskAndPartitionCard"
                        Style="{StaticResource WinPoolCardBorderStyle}" Padding="12">
                        <Grid
                            x:Name="DiskAndPartitionFormGrid"
                            Margin="0"
                            ColumnSpacing="4"
                            RowSpacing="4">
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        </Grid>
        <Border
            x:Name="RealTopologyOverlay"
            Grid.RowSpan="2"
            Background="#B3000000"
            Visibility="Collapsed">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Margin="16"
                MaxWidth="520">
                <ProgressRing
                    x:Name="RealTopologyProgress"
                    IsActive="False"
                    Width="72"
                    Height="72"
                    HorizontalAlignment="Center" />
                <TextBlock
                    x:Name="RealTopologyPhase"
                    Foreground="White"
                    TextWrapping="Wrap"
                    TextAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</editors:EditorPageBase>
