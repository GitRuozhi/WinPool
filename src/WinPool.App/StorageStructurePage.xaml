<?xml version="1.0" encoding="utf-8"?>
<editors:EditorPageBase
    x:Class="WinPool_App.StorageStructurePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinPool_App.Controls"
    xmlns:editors="using:WinPool_App"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="120" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="320" MinWidth="240" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <ScrollViewer
                x:Name="TopologyScrollViewer"
                Padding="8"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Enabled"
                SizeChanged="TopologyScrollViewer_SizeChanged"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl
                    x:Name="TopologyControl"
                    HorizontalAlignment="Stretch">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:TopologyNodeControl
                                HorizontalAlignment="Stretch"
                                ViewModel="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <Border
            Grid.Row="1"
            Margin="0,8,0,0"
            Padding="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <StackPanel Spacing="6">
                <TextBlock x:Name="PendingActionsTitle" FontWeight="SemiBold" />
                <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PendingActionsPanel" Spacing="4">
                        <TextBlock x:Name="PendingActionsEmptyText" />
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>
        <Border
            x:Name="StructureChromeBorder"
            Grid.Row="2"
            Margin="0,8,0,0"
            Padding="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <StackPanel Spacing="6">
                <ScrollViewer
                    x:Name="StructureActionsScrollViewer"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    MaxHeight="220"
                    SizeChanged="StructureActionsScrollViewer_SizeChanged"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Enabled">
                    <controls:FixedWrapPanel
                        x:Name="StructureActionsPanel"
                        Width="176"
                        ItemWidth="176"
                        MinimumItemHeight="44"
                        ItemsPerColumn="2"
                        Spacing="6">
                <controls:ContextHelpHost>
                <Button
                    x:Name="UndoButton"
                    Style="{StaticResource WinPoolButtonBaseStyle}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalAlignment="Center"
                    Click="Undo_Click">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7A7;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="UndoButtonLabel"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                    </Grid>
                </Button>
                </controls:ContextHelpHost>
                <controls:ContextHelpHost>
                <Button
                    x:Name="RedoButton"
                    Grid.Row="1"
                    Style="{StaticResource WinPoolButtonBaseStyle}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalAlignment="Center"
                    Click="Redo_Click">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7A6;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="RedoButtonLabel"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                    </Grid>
                </Button>
                </controls:ContextHelpHost>
                <controls:ContextHelpHost>
                <Button
                    x:Name="DiscardAllButton"
                    Grid.Column="1"
                    Style="{StaticResource WinPoolButtonBaseStyle}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalAlignment="Center"
                    Click="DiscardAll_Click">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE711;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="DiscardAllButtonLabel"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                    </Grid>
                </Button>
                </controls:ContextHelpHost>
                <controls:ContextHelpHost>
                <Button
                    x:Name="ApplyAllButton"
                    Grid.Row="1"
                    Grid.Column="1"
                    Style="{StaticResource WinPoolButtonBaseStyle}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalAlignment="Center"
                    Click="ApplyAll_Click">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE73E;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="ApplyAllButtonLabel"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                    </Grid>
                </Button>
                </controls:ContextHelpHost>
                <controls:ContextHelpHost>
                <Button
                    x:Name="CreatePoolButton"
                    Grid.Column="2"
                    Style="{StaticResource WinPoolButtonBaseStyle}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalAlignment="Center"
                    Click="CreatePool_Click">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE710;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="CreatePoolButtonLabel"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                    </Grid>
                </Button>
                </controls:ContextHelpHost>
                <controls:ContextHelpHost>
                <Button
                    x:Name="DissolveButton"
                    Grid.Row="1"
                    Grid.Column="2"
                    Style="{StaticResource WinPoolButtonBaseStyle}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalAlignment="Center"
                    Click="Dissolve_Click">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE74D;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="DissolveButtonLabel"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                    </Grid>
                </Button>
                </controls:ContextHelpHost>
                <Grid
                    Grid.Column="5"
                    MinHeight="36"
                    ColumnSpacing="4"
                    VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="ShowHotSpareLabel"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap" />
                    <controls:ContextHelpHost Grid.Column="1">
                        <ToggleSwitch
                            x:Name="ShowHotSpareSwitch"
                            MinWidth="0"
                            Margin="0"
                            VerticalAlignment="Center"
                            OffContent=""
                            OnContent=""
                            Toggled="ShowHotSpareSwitch_Toggled" />
                    </controls:ContextHelpHost>
                </Grid>
                <Grid
                    Grid.Row="1"
                    Grid.Column="5"
                    MinHeight="36"
                    ColumnSpacing="4"
                    VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="ShowRetiredLabel"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap" />
                    <controls:ContextHelpHost Grid.Column="1">
                        <ToggleSwitch
                            x:Name="ShowRetiredSwitch"
                            MinWidth="0"
                            Margin="0"
                            VerticalAlignment="Center"
                            OffContent=""
                            OnContent=""
                            Toggled="ShowRetiredSwitch_Toggled" />
                    </controls:ContextHelpHost>
                </Grid>
                <controls:ContextHelpHost>
                <Button
                    x:Name="RetireButton"
                    Grid.Column="4"
                    Style="{StaticResource WinPoolButtonBaseStyle}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalAlignment="Center"
                    Click="Retire_Click">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7E8;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="RetireButtonLabel"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                    </Grid>
                </Button>
                </controls:ContextHelpHost>
                <controls:ContextHelpHost>
                <Button
                    x:Name="HotSpareButton"
                    Grid.Row="1"
                    Grid.Column="4"
                    Style="{StaticResource WinPoolButtonBaseStyle}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalAlignment="Center"
                    Click="HotSpare_Click">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE72C;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="HotSpareButtonLabel"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                    </Grid>
                </Button>
                </controls:ContextHelpHost>
                <controls:ContextHelpHost>
                <Button
                    x:Name="CreateVdiskButton"
                    Grid.Column="3"
                    Style="{StaticResource WinPoolButtonBaseStyle}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalAlignment="Center"
                    Click="CreateVdisk_Click">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE710;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="CreateVdiskButtonLabel"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                    </Grid>
                </Button>
                </controls:ContextHelpHost>
                <controls:ContextHelpHost>
                <Button
                    x:Name="DeleteVdiskButton"
                    Grid.Row="1"
                    Grid.Column="3"
                    Style="{StaticResource WinPoolButtonBaseStyle}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalAlignment="Center"
                    Click="DeleteVdisk_Click">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE74D;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="DeleteVdiskButtonLabel"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                    </Grid>
                </Button>
                </controls:ContextHelpHost>
                    </controls:FixedWrapPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>
        <toolkit:GridSplitter
            Grid.Column="1"
            Grid.RowSpan="3"
            HorizontalAlignment="Stretch"
            Background="{ThemeResource CardStrokeColorDefaultBrush}"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Columns"
            AutomationProperties.Name="Resize topology and properties" />
        <Grid
            Grid.Column="2"
            Grid.RowSpan="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer
                VerticalAlignment="Stretch"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled">
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <Grid
                        x:Name="PoolFormGrid"
                        Margin="8,8,8,8"
                        ColumnSpacing="6"
                        RowSpacing="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </Border>
            </ScrollViewer>
            <controls:ContextHelpHost Grid.Row="1" Margin="0,8,0,0">
            <Button
                x:Name="SavePoolPropertiesButton"
                Style="{StaticResource WinPoolButtonBaseStyle}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalAlignment="Center"
                Click="SavePoolProperties_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE74E;" FontSize="14" />
                    <TextBlock x:Name="SavePoolPropertiesButtonLabel" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            </controls:ContextHelpHost>
        </Grid>
    </Grid>
</editors:EditorPageBase>
