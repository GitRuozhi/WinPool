<?xml version="1.0" encoding="utf-8"?>
<editors:EditorPageBase
    x:Class="WinPool_App.StorageStructurePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinPool_App.Controls"
    xmlns:editors="using:WinPool_App">

    <editors:EditorPageBase.Resources>
        <DataTemplate x:Key="IconActionButtonTemplate">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon
                    Glyph="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                    FontSize="14" />
                <TextBlock
                    VerticalAlignment="Center"
                    Text="{Binding}" />
            </StackPanel>
        </DataTemplate>
        <Style
            x:Key="IconActionButton"
            TargetType="Button">
            <Setter Property="ContentTemplate" Value="{StaticResource IconActionButtonTemplate}" />
        </Style>
    </editors:EditorPageBase.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>
        <Border
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <ScrollViewer
                x:Name="TopologyScrollViewer"
                Padding="8"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Enabled"
                SizeChanged="TopologyScrollViewer_SizeChanged"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl
                    x:Name="TopologyControl"
                    HorizontalAlignment="Stretch">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:TopologyNodeControl
                                HorizontalAlignment="Stretch"
                                ViewModel="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <Grid
            Grid.Column="1"
            Margin="8,0,0,0"
            RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border
                Padding="12,8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <StackPanel Spacing="6">
                    <Grid
                        ColumnSpacing="8"
                        RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button
                            x:Name="UndoButton"
                            Style="{StaticResource IconActionButton}"
                            Tag="&#xE7A7;"
                            HorizontalAlignment="Stretch"
                            Click="Undo_Click" />
                        <Button
                            x:Name="RedoButton"
                            Grid.Column="1"
                            Style="{StaticResource IconActionButton}"
                            Tag="&#xE7A6;"
                            HorizontalAlignment="Stretch"
                            Click="Redo_Click" />
                        <Button
                            x:Name="DiscardAllButton"
                            Grid.Row="1"
                            Style="{StaticResource IconActionButton}"
                            Tag="&#xE711;"
                            HorizontalAlignment="Stretch"
                            Click="DiscardAll_Click" />
                        <Button
                            x:Name="ApplyAllButton"
                            Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource IconActionButton}"
                            Tag="&#xE73E;"
                            HorizontalAlignment="Stretch"
                            Click="ApplyAll_Click" />
                        <Button
                            x:Name="CreatePoolButton"
                            Grid.Row="2"
                            Style="{StaticResource IconActionButton}"
                            Tag="&#xE710;"
                            HorizontalAlignment="Stretch"
                            Click="CreatePool_Click" />
                        <Button
                            x:Name="DissolveButton"
                            Grid.Row="2"
                            Grid.Column="1"
                            Style="{StaticResource IconActionButton}"
                            Tag="&#xE74D;"
                            HorizontalAlignment="Stretch"
                            Click="Dissolve_Click" />
                        <Button
                            x:Name="RetireButton"
                            Grid.Row="3"
                            Style="{StaticResource IconActionButton}"
                            Tag="&#xE7E8;"
                            HorizontalAlignment="Stretch"
                            Click="Retire_Click" />
                        <Button
                            x:Name="HotSpareButton"
                            Grid.Row="3"
                            Grid.Column="1"
                            Style="{StaticResource IconActionButton}"
                            Tag="&#xE72C;"
                            HorizontalAlignment="Stretch"
                            Click="HotSpare_Click" />
                        <Button
                            x:Name="CreateVdiskButton"
                            Grid.Row="4"
                            Style="{StaticResource IconActionButton}"
                            Tag="&#xE710;"
                            HorizontalAlignment="Stretch"
                            Click="CreateVdisk_Click" />
                        <Button
                            x:Name="DeleteVdiskButton"
                            Grid.Row="4"
                            Grid.Column="1"
                            Style="{StaticResource IconActionButton}"
                            Tag="&#xE74D;"
                            HorizontalAlignment="Stretch"
                            Click="DeleteVdisk_Click" />
                    </Grid>
                    <Grid
                        Margin="0,2,0,0"
                        ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="ShowHotSpareLabel"
                            VerticalAlignment="Center" />
                        <ToggleSwitch
                            x:Name="ShowHotSpareSwitch"
                            Grid.Column="1"
                            MinWidth="0"
                            Margin="0"
                            OffContent=""
                            OnContent=""
                            Toggled="ShowHotSpareSwitch_Toggled" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="ShowRetiredLabel"
                            VerticalAlignment="Center" />
                        <ToggleSwitch
                            x:Name="ShowRetiredSwitch"
                            Grid.Column="1"
                            MinWidth="0"
                            Margin="0"
                            OffContent=""
                            OnContent=""
                            Toggled="ShowRetiredSwitch_Toggled" />
                    </Grid>
                </StackPanel>
            </Border>
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <ScrollViewer
                        Padding="8,4,8,8"
                        VerticalScrollBarVisibility="Auto">
                        <Grid
                            x:Name="PoolFormGrid"
                            ColumnSpacing="8"
                            RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </ScrollViewer>
                </Border>
                <Button
                    x:Name="SavePoolPropertiesButton"
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    Style="{StaticResource IconActionButton}"
                    Tag="&#xE74E;"
                    HorizontalAlignment="Stretch"
                    Click="SavePoolProperties_Click" />
            </Grid>
        </Grid>
    </Grid>
</editors:EditorPageBase>
