<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinPool_App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer HorizontalContentAlignment="Stretch">
        <StackPanel
            Padding="24,20,24,40"
            HorizontalAlignment="Stretch"
            Spacing="16">
            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="ThemeTitle"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="主题" />
                    <ComboBox
                        x:Name="ThemeOptions"
                        Grid.Column="1"
                        MinWidth="220"
                        HorizontalAlignment="Left"
                        SelectionChanged="ThemeOptions_SelectionChanged" />
                    <TextBlock
                        x:Name="AccentTitle"
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="主题色" />
                    <ComboBox
                        x:Name="AccentOptions"
                        Grid.Row="1"
                        Grid.Column="1"
                        MinWidth="220"
                        HorizontalAlignment="Left"
                        SelectionChanged="AccentOptions_SelectionChanged" />
                    <TextBlock
                        x:Name="LanguageTitle"
                        Grid.Row="2"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="语言" />
                    <ComboBox
                        x:Name="LanguageOptions"
                        Grid.Row="2"
                        Grid.Column="1"
                        MinWidth="220"
                        HorizontalAlignment="Left"
                        SelectionChanged="LanguageOptions_SelectionChanged" />
                </Grid>
            </Border>

            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="ExecutionTitle"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="执行模式" />
                    <CheckBox
                        x:Name="SettingsExecutionModeSwitch"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Click="SettingsExecutionModeSwitch_Click"
                        Content="本机真实操作" />
                    <TextBlock
                        x:Name="MsrTitle"
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="初始化磁盘" />
                    <CheckBox
                        x:Name="MsrCheckBox"
                        Grid.Row="1"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Click="MsrCheckBox_Click"
                        Content="初始化磁盘时创建微软保留分区（MSR）" />
                    <TextBlock
                        x:Name="PrivacyTitle"
                        Grid.Row="2"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="隐私" />
                    <CheckBox
                        x:Name="ShowHardwareIdsCheckBox"
                        Grid.Row="2"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Click="ShowHardwareIdsCheckBox_Click"
                        Content="显示硬件ID" />
                    <TextBlock
                        x:Name="WelcomeTitle"
                        Grid.Row="3"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="欢迎页面" />
                    <CheckBox
                        x:Name="WelcomeCheckBox"
                        Grid.Row="3"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Click="WelcomeCheckBox_Click"
                        Content="启动时显示欢迎页面" />
                    <TextBlock
                        x:Name="DataLocationTitle"
                        Grid.Row="4"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="数据存储位置" />
                    <StackPanel Grid.Row="4" Grid.Column="1" Spacing="4">
                        <ComboBox
                            x:Name="DataLocationOptions"
                            MinWidth="220"
                            HorizontalAlignment="Left"
                            SelectionChanged="DataLocationOptions_SelectionChanged" />
                        <TextBlock
                            x:Name="DataLocationPath"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="AboutTitle"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="关于" />
                    <StackPanel Grid.Column="1" Spacing="10">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="AboutProductNameLabel" Text="产品" />
                            <TextBlock
                                x:Name="AboutProductNameValue"
                                Grid.Column="1"
                                FontWeight="SemiBold"
                                Text="WinPool" />
                        </Grid>
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="AboutVersionLabel" Text="版本" />
                            <TextBlock
                                x:Name="AboutVersionValue"
                                Grid.Column="1"
                                FontWeight="SemiBold"
                                Text="" />
                        </Grid>
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="AboutProviderLabel" Text="提供方" />
                            <TextBlock
                                Grid.Column="1"
                                FontWeight="SemiBold"
                                Text="GitRuozhi" />
                        </Grid>
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="AboutWebsiteLabel" Text="官网" />
                            <Button x:Name="WebsiteButton" Grid.Column="1" Padding="8,4" Click="WebsiteLink_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="13" Glyph="&#xE774;" />
                                    <TextBlock x:Name="WebsiteButtonText" VerticalAlignment="Center" Text="访问官网" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="AboutUpdateLabel" Text="更新" />
                            <Button x:Name="UpdateButton" Grid.Column="1" Padding="8,4" Click="UpdateLink_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="13" Glyph="&#xE777;" />
                                    <TextBlock x:Name="UpdateButtonText" VerticalAlignment="Center" Text="查看更新" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="AboutFeedbackLabel" Text="反馈" />
                            <Button x:Name="FeedbackButton" Grid.Column="1" Padding="8,4" Click="FeedbackLink_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="13" Glyph="&#xE8F2;" />
                                    <TextBlock x:Name="FeedbackButtonText" VerticalAlignment="Center" Text="提交反馈" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="AboutCommunityLabel" Text="轻松交流" />
                            <TextBlock
                                x:Name="AboutCommunityValue"
                                Grid.Column="1"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="QQ 群（暂未开放）" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
