<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinPool_App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer HorizontalContentAlignment="Stretch">
        <StackPanel
            Padding="24,20,24,40"
            HorizontalAlignment="Stretch"
            Spacing="16">
            <StackPanel Margin="0,0,0,8" Spacing="8">
                <TextBlock
                    x:Name="SettingsTitle"
                    FontSize="32"
                    FontWeight="SemiBold"
                    Text="设置" />
            </StackPanel>

            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="ThemeTitle"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="主题" />
                    <ComboBox
                        x:Name="ThemeOptions"
                        Grid.Column="1"
                        MinWidth="220"
                        HorizontalAlignment="Left"
                        SelectionChanged="ThemeOptions_SelectionChanged" />
                    <TextBlock
                        x:Name="AccentTitle"
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="主题色" />
                    <ComboBox
                        x:Name="AccentOptions"
                        Grid.Row="1"
                        Grid.Column="1"
                        MinWidth="220"
                        HorizontalAlignment="Left"
                        SelectionChanged="AccentOptions_SelectionChanged" />
                    <TextBlock
                        x:Name="LanguageTitle"
                        Grid.Row="2"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="语言" />
                    <ComboBox
                        x:Name="LanguageOptions"
                        Grid.Row="2"
                        Grid.Column="1"
                        MinWidth="220"
                        HorizontalAlignment="Left"
                        SelectionChanged="LanguageOptions_SelectionChanged" />
                </Grid>
            </Border>

            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="ExecutionTitle"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="执行模式" />
                    <CheckBox
                        x:Name="SettingsExecutionModeSwitch"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Click="SettingsExecutionModeSwitch_Click"
                        Content="本机真实操作" />
                    <TextBlock
                        x:Name="MsrTitle"
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="初始化磁盘" />
                    <CheckBox
                        x:Name="MsrCheckBox"
                        Grid.Row="1"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Click="MsrCheckBox_Click"
                        Content="初始化磁盘时创建微软保留分区（MSR）" />
                    <TextBlock
                        x:Name="PrivacyTitle"
                        Grid.Row="2"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="隐私" />
                    <CheckBox
                        x:Name="ShowHardwareIdsCheckBox"
                        Grid.Row="2"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Click="ShowHardwareIdsCheckBox_Click"
                        Content="显示硬件ID" />
                </Grid>
            </Border>

            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="AboutTitle"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="关于" />
                    <StackPanel Grid.Column="1" Spacing="10">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="AboutProductNameLabel" Text="产品" />
                            <TextBlock
                                x:Name="AboutProductNameValue"
                                Grid.Column="1"
                                FontWeight="SemiBold"
                                Text="WinPool" />
                        </Grid>
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="AboutVersionLabel" Text="版本" />
                            <TextBlock
                                x:Name="AboutVersionValue"
                                Grid.Column="1"
                                FontWeight="SemiBold"
                                Text="" />
                        </Grid>
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="AboutProviderLabel" Text="提供方" />
                            <TextBlock
                                Grid.Column="1"
                                FontWeight="SemiBold"
                                Text="GitRuozhi" />
                        </Grid>
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="AboutWebsiteLabel" Text="官网" />
                            <HyperlinkButton
                                x:Name="WebsiteLink"
                                Grid.Column="1"
                                Padding="0"
                                Click="WebsiteLink_Click"
                                Content="github.com/GitRuozhi/WinPool" />
                        </Grid>
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="AboutUpdateLabel" Text="更新" />
                            <HyperlinkButton
                                x:Name="UpdateLink"
                                Grid.Column="1"
                                Padding="0"
                                Click="UpdateLink_Click"
                                Content="GitHub Releases" />
                        </Grid>
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="AboutFeedbackLabel" Text="反馈" />
                            <HyperlinkButton
                                x:Name="FeedbackLink"
                                Grid.Column="1"
                                Padding="0"
                                Click="FeedbackLink_Click"
                                Content="GitHub Issues" />
                        </Grid>
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="AboutCommunityLabel" Text="轻松交流" />
                            <TextBlock
                                x:Name="AboutCommunityValue"
                                Grid.Column="1"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="QQ 群（暂未开放）" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
