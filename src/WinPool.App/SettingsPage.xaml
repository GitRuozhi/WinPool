<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinPool_App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="SettingsCardBorder" TargetType="Border">
            <Setter Property="Padding" Value="20" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style x:Key="SettingsFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SettingsFieldValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <ScrollViewer HorizontalContentAlignment="Stretch">
        <StackPanel
            Padding="24,20,24,40"
            HorizontalAlignment="Stretch"
            Spacing="16">
            <Border Style="{StaticResource SettingsCardBorder}">
                <Grid ColumnSpacing="16" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" MinHeight="32" />
                        <RowDefinition Height="Auto" MinHeight="32" />
                        <RowDefinition Height="Auto" MinHeight="32" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="ThemeTitle"
                        Style="{StaticResource SettingsFieldLabel}"
                        Text="主题" />
                    <ComboBox
                        x:Name="ThemeOptions"
                        Grid.Column="1"
                        MinWidth="220"
                        MinHeight="32"
                        FontSize="14"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        SelectionChanged="ThemeOptions_SelectionChanged" />
                    <TextBlock
                        x:Name="AccentTitle"
                        Grid.Row="1"
                        Style="{StaticResource SettingsFieldLabel}"
                        Text="主题色" />
                    <ComboBox
                        x:Name="AccentOptions"
                        Grid.Row="1"
                        Grid.Column="1"
                        MinWidth="220"
                        MinHeight="32"
                        FontSize="14"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        SelectionChanged="AccentOptions_SelectionChanged" />
                    <TextBlock
                        x:Name="LanguageTitle"
                        Grid.Row="2"
                        Style="{StaticResource SettingsFieldLabel}"
                        Text="语言" />
                    <ComboBox
                        x:Name="LanguageOptions"
                        Grid.Row="2"
                        Grid.Column="1"
                        MinWidth="220"
                        MinHeight="32"
                        FontSize="14"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        SelectionChanged="LanguageOptions_SelectionChanged" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCardBorder}">
                <Grid ColumnSpacing="16" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" MinHeight="32" />
                        <RowDefinition Height="Auto" MinHeight="32" />
                        <RowDefinition Height="Auto" MinHeight="32" />
                        <RowDefinition Height="Auto" MinHeight="32" />
                        <RowDefinition Height="Auto" MinHeight="32" />
                        <RowDefinition Height="Auto" MinHeight="32" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="WelcomeTitle"
                        Style="{StaticResource SettingsFieldLabel}"
                        Text="欢迎页面" />
                    <Button
                        x:Name="WelcomeButton"
                        Grid.Column="1"
                        MinWidth="220"
                        MinHeight="32"
                        FontSize="14"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Click="WelcomeButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE8A7;" />
                            <TextBlock
                                x:Name="WelcomeButtonText"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Text="打开欢迎内容" />
                        </StackPanel>
                    </Button>
                    <TextBlock
                        x:Name="StartupAgentTitle"
                        Grid.Row="1"
                        Style="{StaticResource SettingsFieldLabel}"
                        Text="开机启动" />
                    <ToggleSwitch
                        x:Name="StartupAgentSwitch"
                        Grid.Row="1"
                        Grid.Column="1"
                        MinHeight="32"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        OffContent=""
                        OnContent=""
                        Toggled="StartupAgentSwitch_Toggled" />
                    <TextBlock
                        x:Name="ExecutionTitle"
                        Grid.Row="2"
                        Style="{StaticResource SettingsFieldLabel}"
                        Text="本机真实操作" />
                    <ToggleSwitch
                        x:Name="SettingsExecutionModeSwitch"
                        Grid.Row="2"
                        Grid.Column="1"
                        MinHeight="32"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        OffContent=""
                        OnContent=""
                        Toggled="SettingsExecutionModeSwitch_Toggled" />
                    <TextBlock
                        x:Name="PrivacyTitle"
                        Grid.Row="3"
                        Style="{StaticResource SettingsFieldLabel}"
                        Text="显示硬件ID" />
                    <ToggleSwitch
                        x:Name="ShowHardwareIdsSwitch"
                        Grid.Row="3"
                        Grid.Column="1"
                        MinHeight="32"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        OffContent=""
                        OnContent=""
                        Toggled="ShowHardwareIdsSwitch_Toggled" />
                    <TextBlock
                        x:Name="MsrTitle"
                        Grid.Row="4"
                        Style="{StaticResource SettingsFieldLabel}"
                        Text="初始化磁盘时创建微软保留分区" />
                    <ToggleSwitch
                        x:Name="MsrSwitch"
                        Grid.Row="4"
                        Grid.Column="1"
                        MinHeight="32"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        OffContent=""
                        OnContent=""
                        Toggled="MsrSwitch_Toggled" />
                    <TextBlock
                        x:Name="DataLocationTitle"
                        Grid.Row="5"
                        Style="{StaticResource SettingsFieldLabel}"
                        Text="数据存储位置" />
                    <Grid
                        Grid.Row="5"
                        Grid.Column="1"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            x:Name="DataLocationOptions"
                            MinWidth="220"
                            MinHeight="32"
                            FontSize="14"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            SelectionChanged="DataLocationOptions_SelectionChanged" />
                        <TextBlock
                            x:Name="DataLocationPath"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </Grid>
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCardBorder}">
                <Grid ColumnSpacing="16" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" MinHeight="32" />
                        <RowDefinition Height="Auto" MinHeight="32" />
                        <RowDefinition Height="Auto" MinHeight="32" />
                        <RowDefinition Height="Auto" MinHeight="32" />
                        <RowDefinition Height="Auto" MinHeight="32" />
                        <RowDefinition Height="Auto" MinHeight="32" />
                        <RowDefinition Height="Auto" MinHeight="32" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="AboutProductNameLabel"
                        Style="{StaticResource SettingsFieldLabel}"
                        Text="产品" />
                    <TextBlock
                        x:Name="AboutProductNameValue"
                        Grid.Column="1"
                        Style="{StaticResource SettingsFieldValue}"
                        Text="WinPool" />
                    <TextBlock
                        x:Name="AboutVersionLabel"
                        Grid.Row="1"
                        Style="{StaticResource SettingsFieldLabel}"
                        Text="版本" />
                    <TextBlock
                        x:Name="AboutVersionValue"
                        Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource SettingsFieldValue}" />
                    <TextBlock
                        x:Name="AboutProviderLabel"
                        Grid.Row="2"
                        Style="{StaticResource SettingsFieldLabel}"
                        Text="提供方" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        Style="{StaticResource SettingsFieldValue}"
                        Text="GitRuozhi" />
                    <TextBlock
                        x:Name="AboutWebsiteLabel"
                        Grid.Row="3"
                        Style="{StaticResource SettingsFieldLabel}"
                        Text="官网" />
                    <Button
                        x:Name="WebsiteButton"
                        Grid.Row="3"
                        Grid.Column="1"
                        MinWidth="220"
                        MinHeight="32"
                        FontSize="14"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Click="WebsiteLink_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE774;" />
                            <TextBlock x:Name="WebsiteButtonText" VerticalAlignment="Center" FontSize="14" Text="访问官网" />
                        </StackPanel>
                    </Button>
                    <TextBlock
                        x:Name="AboutUpdateLabel"
                        Grid.Row="4"
                        Style="{StaticResource SettingsFieldLabel}"
                        Text="更新" />
                    <Button
                        x:Name="UpdateButton"
                        Grid.Row="4"
                        Grid.Column="1"
                        MinWidth="220"
                        MinHeight="32"
                        FontSize="14"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Click="UpdateLink_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE777;" />
                            <TextBlock x:Name="UpdateButtonText" VerticalAlignment="Center" FontSize="14" Text="查看更新" />
                        </StackPanel>
                    </Button>
                    <TextBlock
                        x:Name="AboutFeedbackLabel"
                        Grid.Row="5"
                        Style="{StaticResource SettingsFieldLabel}"
                        Text="反馈" />
                    <Button
                        x:Name="FeedbackButton"
                        Grid.Row="5"
                        Grid.Column="1"
                        MinWidth="220"
                        MinHeight="32"
                        FontSize="14"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Click="FeedbackLink_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE8F2;" />
                            <TextBlock x:Name="FeedbackButtonText" VerticalAlignment="Center" FontSize="14" Text="提交反馈" />
                        </StackPanel>
                    </Button>
                    <TextBlock
                        x:Name="AboutCommunityLabel"
                        Grid.Row="6"
                        Style="{StaticResource SettingsFieldLabel}"
                        Text="轻松交流" />
                    <Button
                        x:Name="AboutCommunityButton"
                        Grid.Row="6"
                        Grid.Column="1"
                        MinWidth="220"
                        MinHeight="32"
                        FontSize="14"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Click="CommunityButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE8F2;" />
                            <TextBlock
                                x:Name="CommunityButtonText"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Text="加入 QQ 群" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
