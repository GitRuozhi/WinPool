<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinPool_App.MonitorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinPool_App.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid
        x:Name="MonitorRoot"
        Padding="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="GraphRow" Height="3*" MinHeight="160" />
            <RowDefinition Height="8" />
            <RowDefinition x:Name="TableRow" Height="2*" MinHeight="140" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Padding="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
                <controls:DiskActivityGraphControl x:Name="ActivityGraph" />
                <Border
                    Margin="12"
                    Padding="8,5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="4"
                    IsHitTestVisible="False">
                    <TextBlock
                        x:Name="MonitorStatusText"
                        MaxWidth="520"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Border>

        <toolkit:GridSplitter
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            Background="Transparent"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Rows"
            AutomationProperties.Name="Resize monitor areas" />

        <Border
            Grid.Row="2"
            Padding="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid x:Name="TableHeader" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="0.7*" />
                        <ColumnDefinition Width="0.8*" />
                        <ColumnDefinition Width="0.9*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="HeaderColor" Grid.Column="1" FontWeight="SemiBold" Text="颜色" />
                    <TextBlock x:Name="HeaderName" Grid.Column="2" FontWeight="SemiBold" Text="名称" />
                    <TextBlock x:Name="HeaderPool" Grid.Column="3" FontWeight="SemiBold" Text="池" />
                    <TextBlock x:Name="HeaderVolumes" Grid.Column="4" FontWeight="SemiBold" Text="卷" />
                    <TextBlock x:Name="HeaderMedia" Grid.Column="5" FontWeight="SemiBold" Text="介质" />
                    <TextBlock x:Name="HeaderCapacity" Grid.Column="6" FontWeight="SemiBold" Text="容量" />
                    <TextBlock x:Name="HeaderActivity" Grid.Column="7" FontWeight="SemiBold" Text="活动" />
                    <TextBlock x:Name="HeaderRead" Grid.Column="8" FontWeight="SemiBold" Text="读取速度" />
                    <TextBlock x:Name="HeaderWrite" Grid.Column="9" FontWeight="SemiBold" Text="写入速度" />
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="DiskRows">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid
                                    Padding="0,4"
                                    ColumnSpacing="8"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="0.7*" />
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox
                                        VerticalAlignment="Center"
                                        IsChecked="{Binding ShowInGraph, Mode=TwoWay}" />
                                    <Button
                                        Grid.Column="1"
                                        Padding="2"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="ColorSwatch_Click">
                                        <Border
                                            Width="44"
                                            Height="12"
                                            CornerRadius="2"
                                            Background="{Binding SeriesColorBrush}" />
                                    </Button>
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="3"
                                        VerticalAlignment="Center"
                                        Text="{Binding Pool}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="4"
                                        VerticalAlignment="Center"
                                        Text="{Binding Volumes}" />
                                    <TextBlock
                                        Grid.Column="5"
                                        VerticalAlignment="Center"
                                        Text="{Binding Media}" />
                                    <TextBlock
                                        Grid.Column="6"
                                        VerticalAlignment="Center"
                                        Text="{Binding Capacity}" />
                                    <TextBlock
                                        Grid.Column="7"
                                        VerticalAlignment="Center"
                                        Text="{Binding ActivityText}" />
                                    <TextBlock
                                        Grid.Column="8"
                                        VerticalAlignment="Center"
                                        Text="{Binding ReadText}" />
                                    <TextBlock
                                        Grid.Column="9"
                                        VerticalAlignment="Center"
                                        Text="{Binding WriteText}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border
            x:Name="ButtonsCard"
            Grid.Row="4"
            Padding="12,8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="12">
                    <CheckBox
                        x:Name="ContinuousMonitoringCheckBox"
                        AccessKey="C"
                        VerticalAlignment="Center"
                        Click="ContinuousMonitoringCheckBox_Click"
                        Content="持续监控" />
                    <TextBlock
                        x:Name="SamplingRateLabel"
                        VerticalAlignment="Center"
                        Text="采样频率" />
                    <ComboBox
                        x:Name="RateOptions"
                        MinWidth="100"
                        VerticalAlignment="Center"
                        SelectionChanged="RateOptions_SelectionChanged" />
                    <Button x:Name="AutoColorsButton" Click="AutoColors_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE790;" />
                            <TextBlock VerticalAlignment="Center" Text="自动颜色" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="EventsButton" Click="EventsButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE7B5;" />
                            <TextBlock
                                x:Name="EventsButtonText"
                                VerticalAlignment="Center"
                                Text="事件" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="12">
                    <Button x:Name="ExportButton" Click="ExportButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE74E;" />
                            <TextBlock VerticalAlignment="Center" Text="导出数据" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
