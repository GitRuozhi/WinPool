<?xml version="1.0" encoding="utf-8"?>
<editors:EditorPageBase
    x:Class="WinPool_App.DiskPartitionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinPool_App.Controls"
    xmlns:editors="using:WinPool_App">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>
        <Border
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <ScrollViewer
                x:Name="TopologyScrollViewer"
                Padding="8"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Enabled"
                SizeChanged="TopologyScrollViewer_SizeChanged"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl
                    x:Name="TopologyControl"
                    HorizontalAlignment="Stretch">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:TopologyNodeControl
                                HorizontalAlignment="Stretch"
                                ViewModel="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <Border
            Grid.Column="1"
            Margin="8,0,0,0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <ScrollViewer Padding="12,8" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="UndoButton" HorizontalAlignment="Stretch" Click="Undo_Click" />
                        <Button x:Name="RedoButton" Grid.Column="1" HorizontalAlignment="Stretch" Click="Redo_Click" />
                    </Grid>
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="DiscardAllButton" HorizontalAlignment="Stretch" Click="DiscardAll_Click" />
                        <Button x:Name="ApplyAllButton" Grid.Column="1" HorizontalAlignment="Stretch" Click="ApplyAll_Click" />
                    </Grid>
                    <TextBlock
                        x:Name="SelectedPartitionInfo"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="DiskActionsTitle"
                        Margin="0,10,0,0"
                        FontWeight="SemiBold" />
                    <Button x:Name="InitializeButton" HorizontalAlignment="Stretch" Click="Initialize_Click" />
                    <Button x:Name="OfflineButton" HorizontalAlignment="Stretch" Click="Offline_Click" />
                    <TextBlock
                        x:Name="PartitionActionsTitle"
                        Margin="0,10,0,0"
                        FontWeight="SemiBold" />
                    <Button x:Name="ExtendButton" HorizontalAlignment="Stretch" Click="Extend_Click" />
                    <Button x:Name="ShrinkButton" HorizontalAlignment="Stretch" Click="Shrink_Click" />
                    <Button x:Name="DeletePartitionButton" HorizontalAlignment="Stretch" Click="DeletePartition_Click" />
                    <Button x:Name="FormatButton" HorizontalAlignment="Stretch" Click="Format_Click" />
                    <Button x:Name="NewPartitionButton" HorizontalAlignment="Stretch" Click="NewPartition_Click" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</editors:EditorPageBase>
