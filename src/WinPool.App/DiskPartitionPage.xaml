<?xml version="1.0" encoding="utf-8"?>
<editors:EditorPageBase
    x:Class="WinPool_App.DiskPartitionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinPool_App.Controls"
    xmlns:editors="using:WinPool_App">

    <editors:EditorPageBase.Resources>
        <Style x:Key="PartitionChromeButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="PropertyResetButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </editors:EditorPageBase.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <ScrollViewer
                x:Name="TopologyScrollViewer"
                Padding="8"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Enabled"
                SizeChanged="TopologyScrollViewer_SizeChanged"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl
                    x:Name="TopologyControl"
                    HorizontalAlignment="Stretch">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:TopologyNodeControl
                                HorizontalAlignment="Stretch"
                                ViewModel="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <Border
            x:Name="PartitionChromeBorder"
            Grid.Row="1"
            Margin="0,8,0,0"
            Padding="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <controls:FixedWrapPanel ItemWidth="176" ItemHeight="44" Spacing="6">
                <Button
                    x:Name="OnlineButton"
                    Style="{StaticResource PartitionChromeButtonStyle}"
                    Click="Online_Click">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8FB;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="OnlineButtonLabel"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                    </Grid>
                </Button>
                <Button
                    x:Name="OfflineButton"
                    Grid.Column="1"
                    Style="{StaticResource PartitionChromeButtonStyle}"
                    Click="Offline_Click">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8AE;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="OfflineButtonLabel"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                    </Grid>
                </Button>
                <Button
                    x:Name="InitializeButton"
                    Grid.Column="2"
                    Style="{StaticResource PartitionChromeButtonStyle}"
                    Click="Initialize_Click">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE9CE;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="InitializeButtonLabel"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                    </Grid>
                </Button>
                <Button
                    x:Name="ConvertGptButton"
                    Grid.Column="3"
                    Style="{StaticResource PartitionChromeButtonStyle}"
                    Click="ConvertGpt_Click">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8AB;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="ConvertGptButtonLabel"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                    </Grid>
                </Button>
                <Button
                    x:Name="NewPartitionButton"
                    Grid.Column="4"
                    Style="{StaticResource PartitionChromeButtonStyle}"
                    Click="NewPartition_Click">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE710;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="NewPartitionButtonLabel"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                    </Grid>
                </Button>
                <Button
                    x:Name="DeletePartitionButton"
                    Grid.Column="5"
                    Style="{StaticResource PartitionChromeButtonStyle}"
                    Click="DeletePartition_Click">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE74D;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="DeletePartitionButtonLabel"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                    </Grid>
                </Button>
                <Button
                    x:Name="ExtendButton"
                    Grid.Column="6"
                    Style="{StaticResource PartitionChromeButtonStyle}">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8A5;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="ExtendButtonLabel"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                    </Grid>
                </Button>
                <Button
                    x:Name="ShrinkButton"
                    Grid.Column="7"
                    Style="{StaticResource PartitionChromeButtonStyle}">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE73F;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="ShrinkButtonLabel"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                    </Grid>
                </Button>
                <Button
                    x:Name="OpenExplorerButton"
                    Grid.Column="8"
                    Style="{StaticResource PartitionChromeButtonStyle}"
                    Click="OpenExplorer_Click">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE838;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="OpenExplorerButtonLabel"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                    </Grid>
                </Button>
            </controls:FixedWrapPanel>
        </Border>
        <ScrollViewer
            Grid.Column="1"
            Grid.RowSpan="2"
            Margin="8,0,0,0"
            VerticalAlignment="Stretch"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Grid
                            x:Name="PartitionFormGrid"
                            Margin="8"
                            ColumnSpacing="6"
                            RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                x:Name="DiskLocationLabel"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="DiskLocationValue"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="PartitionNumberLabel"
                                Grid.Row="1"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="PartitionNumberValue"
                                Grid.Row="1"
                                Grid.Column="2"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="StartOffsetLabel"
                                Grid.Row="2"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="StartOffsetValue"
                                Grid.Row="2"
                                Grid.Column="2"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="EndOffsetLabel"
                                Grid.Row="3"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="EndOffsetValue"
                                Grid.Row="3"
                                Grid.Column="2"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="PartitionTypeLabel"
                                Grid.Row="4"
                                VerticalAlignment="Center" />
                            <ComboBox
                                x:Name="PartitionTypeBox"
                                Grid.Row="4"
                                Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="PartitionTypeBox_SelectionChanged" />
                            <TextBlock
                                x:Name="DriveLetterLabel"
                                Grid.Row="5"
                                VerticalAlignment="Center" />
                            <ComboBox
                                x:Name="DriveLetterBox"
                                Grid.Row="5"
                                Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="DriveLetterBox_SelectionChanged" />
                            <TextBlock
                                x:Name="VolumeLabelCaption"
                                Grid.Row="6"
                                VerticalAlignment="Center" />
                            <TextBox
                                x:Name="VolumeLabelBox"
                                Grid.Row="6"
                                Grid.Column="2"
                                KeyDown="VolumeLabelBox_KeyDown" />
                            <StackPanel
                                Grid.Row="7"
                                Orientation="Horizontal"
                                Spacing="5"
                                VerticalAlignment="Center">
                                <TextBlock x:Name="SizeLabel" VerticalAlignment="Center" />
                                <Border
                                    x:Name="SizeChangedIndicator"
                                    Width="6"
                                    Height="6"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="3"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed" />
                            </StackPanel>
                            <Button
                                x:Name="ResetSizeButton"
                                Grid.Row="7"
                                Grid.Column="1"
                                Style="{StaticResource PropertyResetButtonStyle}"
                                Click="ResetSize_Click"
                                Visibility="Collapsed">
                                <FontIcon Glyph="&#xE777;" FontSize="12" />
                            </Button>
                            <NumberBox
                                x:Name="SizeBox"
                                Grid.Row="7"
                                Grid.Column="2"
                                Minimum="0"
                                SmallChange="1"
                                LargeChange="10"
                                SpinButtonPlacementMode="Hidden"
                                ValidationMode="InvalidInputOverwritten"
                                ValueChanged="SizeBox_ValueChanged" />
                            <StackPanel
                                Grid.Row="8"
                                Orientation="Horizontal"
                                Spacing="5"
                                VerticalAlignment="Center">
                                <TextBlock x:Name="FileSystemLabel" VerticalAlignment="Center" />
                                <Border
                                    x:Name="FileSystemChangedIndicator"
                                    Width="6"
                                    Height="6"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="3"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed" />
                            </StackPanel>
                            <Button
                                x:Name="ResetFileSystemButton"
                                Grid.Row="8"
                                Grid.Column="1"
                                Style="{StaticResource PropertyResetButtonStyle}"
                                Click="ResetFileSystem_Click"
                                Visibility="Collapsed">
                                <FontIcon Glyph="&#xE777;" FontSize="12" />
                            </Button>
                            <ComboBox
                                x:Name="FileSystemBox"
                                Grid.Row="8"
                                Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="FileSystemBox_SelectionChanged" />
                            <StackPanel
                                Grid.Row="9"
                                Orientation="Horizontal"
                                Spacing="5"
                                VerticalAlignment="Center">
                                <TextBlock x:Name="ClusterLabel" VerticalAlignment="Center" />
                                <Border
                                    x:Name="ClusterChangedIndicator"
                                    Width="6"
                                    Height="6"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="3"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed" />
                            </StackPanel>
                            <Button
                                x:Name="ResetClusterButton"
                                Grid.Row="9"
                                Grid.Column="1"
                                Style="{StaticResource PropertyResetButtonStyle}"
                                Click="ResetCluster_Click"
                                Visibility="Collapsed">
                                <FontIcon Glyph="&#xE777;" FontSize="12" />
                            </Button>
                            <ComboBox
                                x:Name="ClusterBox"
                                Grid.Row="9"
                                Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="ClusterBox_SelectionChanged" />
                            <StackPanel
                                Grid.Row="10"
                                Orientation="Horizontal"
                                Spacing="5"
                                VerticalAlignment="Center">
                                <TextBlock x:Name="QuickFormatLabel" VerticalAlignment="Center" />
                                <Border
                                    x:Name="QuickFormatChangedIndicator"
                                    Width="6"
                                    Height="6"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="3"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed" />
                            </StackPanel>
                            <Button
                                x:Name="ResetQuickFormatButton"
                                Grid.Row="10"
                                Grid.Column="1"
                                Style="{StaticResource PropertyResetButtonStyle}"
                                Click="ResetQuickFormat_Click"
                                Visibility="Collapsed">
                                <FontIcon Glyph="&#xE777;" FontSize="12" />
                            </Button>
                            <ToggleSwitch
                                x:Name="QuickFormatSwitch"
                                Grid.Row="10"
                                Grid.Column="2"
                                MinWidth="0"
                                Margin="0"
                                OffContent=""
                                OnContent=""
                                Toggled="QuickFormatSwitch_Toggled" />
                        </Grid>
                    </Border>
                    <Button
                        x:Name="FormatButton"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Stretch"
                        Click="Format_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="FormatButtonIcon" Glyph="&#xE9CE;" FontSize="14" />
                            <TextBlock x:Name="FormatButtonLabel" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
    </Grid>
</editors:EditorPageBase>
