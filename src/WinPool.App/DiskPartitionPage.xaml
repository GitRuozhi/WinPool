<?xml version="1.0" encoding="utf-8"?>
<editors:EditorPageBase
    x:Class="WinPool_App.DiskPartitionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinPool_App.Controls"
    xmlns:editors="using:WinPool_App"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <Grid x:Name="PageRootGrid" Margin="8,0,8,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel
            x:Name="NarrowPageNavigation"
            Orientation="Horizontal"
            Spacing="6"
            Margin="0,0,0,6"
            Visibility="Collapsed">
            <Button x:Name="ShowTargetsButton" Click="ShowTargets_Click" />
            <Button x:Name="ShowPropertiesButton" Click="ShowProperties_Click" />
        </StackPanel>
        <Grid x:Name="EditorLayoutGrid" Grid.Row="1"
              SizeChanged="EditorLayoutGrid_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="TargetsColumn" Width="*" MinWidth="120" />
            <ColumnDefinition x:Name="SplitterColumn" Width="8" />
            <ColumnDefinition x:Name="PropertiesColumn" Width="380" MinWidth="240" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border
            x:Name="TopologyBorder"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
                <ScrollViewer
                    x:Name="TopologyScrollViewer"
                    Padding="12"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    SizeChanged="TopologyScrollViewer_SizeChanged"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl
                        x:Name="TopologyControl"
                        HorizontalAlignment="Stretch">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:TopologyNodeControl
                                    HorizontalAlignment="Stretch"
                                    ViewModel="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

            </Grid>
        </Border>
        <toolkit:GridSplitter
            x:Name="EditorSplitter"
            Grid.Column="1"
            Grid.RowSpan="2"
            HorizontalAlignment="Stretch"
            Background="{ThemeResource CardStrokeColorDefaultBrush}"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Columns"
            AutomationProperties.Name="Resize topology and properties" />
        <Border
            x:Name="PartitionChromeBorder"
            Grid.Row="1"
            Margin="0,6,0,0"
            Padding="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <StackPanel Spacing="8">
                <ScrollViewer
                    x:Name="PartitionActionsScrollViewer"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    MaxHeight="220"
                    SizeChanged="PartitionActionsScrollViewer_SizeChanged"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Enabled">
                <controls:FixedWrapPanel
                    x:Name="PartitionActionsPanel"
                    Width="176"
                    ItemWidth="176"
                    MinimumItemHeight="40"
                    Spacing="8">
                <controls:ContextHelpHost>
                    <Button
                        x:Name="DiskOnlineStateButton"
                        Style="{StaticResource WinPoolButtonBaseStyle}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Click="DiskOnlineState_Click">
                        <Grid HorizontalAlignment="Center" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="DiskOnlineStateButtonIcon" Glyph="&#xE8AE;" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="DiskOnlineStateButtonLabel"
                                Grid.Column="1"
                                MaxWidth="128"
                                VerticalAlignment="Center"
                                TextWrapping="Wrap" />
                        </Grid>
                    </Button>
                </controls:ContextHelpHost>
                <controls:ContextHelpHost>
                    <Button
                        x:Name="DiskPartitionStyleButton"
                        Style="{StaticResource WinPoolButtonBaseStyle}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Click="DiskPartitionStyleButton_Click">
                        <Grid HorizontalAlignment="Center" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="DiskPartitionStyleButtonIcon" Glyph="&#xE9CE;" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="DiskPartitionStyleButtonLabel"
                                Grid.Column="1"
                                MaxWidth="128"
                                VerticalAlignment="Center"
                                TextWrapping="Wrap" />
                        </Grid>
                    </Button>
                </controls:ContextHelpHost>
                <controls:ContextHelpHost>
                <Button
                    x:Name="ClearDiskButton"
                    Style="{StaticResource WinPoolButtonBaseStyle}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Click="ClearDisk_Click">
                    <Grid HorizontalAlignment="Center" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE74D;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock x:Name="ClearDiskButtonLabel"
                                   Grid.Column="1"
                                   MaxWidth="128"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </Grid>
                </Button>
                </controls:ContextHelpHost>
                <controls:ContextHelpHost>
                <Button
                    x:Name="DeletePartitionButton"
                    Grid.Column="4"
                    Style="{StaticResource WinPoolButtonBaseStyle}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Click="DeletePartition_Click">
                    <Grid HorizontalAlignment="Center" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE74D;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="DeletePartitionButtonLabel"
                            Grid.Column="1"
                            MaxWidth="128"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                    </Grid>
                </Button>
                </controls:ContextHelpHost>
                <controls:ContextHelpHost>
                <Button
                    x:Name="ExtendButton"
                    Grid.Column="5"
                    Style="{StaticResource WinPoolButtonBaseStyle}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Click="Extend_Click">
                    <Grid HorizontalAlignment="Center" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8A5;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="ExtendButtonLabel"
                            Grid.Column="1"
                            MaxWidth="128"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                    </Grid>
                </Button>
                </controls:ContextHelpHost>
                <controls:ContextHelpHost>
                <Button
                    x:Name="ShrinkButton"
                    Grid.Column="6"
                    Style="{StaticResource WinPoolButtonBaseStyle}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Click="Shrink_Click">
                    <Grid HorizontalAlignment="Center" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE73F;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="ShrinkButtonLabel"
                            Grid.Column="1"
                            MaxWidth="128"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                    </Grid>
                </Button>
                </controls:ContextHelpHost>
                <controls:ContextHelpHost>
                <Button
                    x:Name="OpenExplorerButton"
                    Grid.Column="7"
                    Style="{StaticResource WinPoolButtonBaseStyle}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Click="OpenExplorer_Click">
                    <Grid HorizontalAlignment="Center" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE838;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="OpenExplorerButtonLabel"
                            Grid.Column="1"
                            MaxWidth="128"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                    </Grid>
                </Button>
                </controls:ContextHelpHost>
                </controls:FixedWrapPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>
        <ScrollViewer x:Name="PropertiesPane" Grid.Column="2" Grid.RowSpan="2"
                      VerticalAlignment="Stretch" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled">
            <StackPanel Spacing="{StaticResource WinPoolCardGap}">
                <Border x:Name="DiskVolumeCard" Padding="12" Style="{StaticResource WinPoolCardBorderStyle}">
                    <StackPanel Spacing="4">
                        <Button
                            x:Name="DiskVolumeCardHeader"
                            Style="{StaticResource WinPoolButtonBaseStyle}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            MinHeight="32"
                            Padding="0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Click="PropertyCardHeader_Click">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="DiskVolumeCardTitle" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <FontIcon x:Name="DiskVolumeCardDirection" Grid.Column="1" Glyph="&#xE70D;" FontSize="12" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <StackPanel x:Name="DiskVolumeCardContent" Spacing="4">
                            <Grid x:Name="PartitionFormGrid" ColumnSpacing="4" RowSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" MinHeight="40" />
                                    <RowDefinition Height="84" />
                                    <RowDefinition Height="40" />
                                    <RowDefinition Height="40" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="DiskLocationLabel" TextWrapping="Wrap" MaxLines="2" VerticalAlignment="Center" />
                                <TextBlock x:Name="DiskLocationValue" Grid.Column="2" Grid.ColumnSpan="3" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Grid Grid.Row="1" RowSpacing="4">
                                    <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="40" /></Grid.RowDefinitions>
                                    <TextBlock x:Name="StartOffsetLabel" TextWrapping="Wrap" MaxLines="2" VerticalAlignment="Center" />
                                    <TextBlock x:Name="EndOffsetLabel" Grid.Row="1" TextWrapping="Wrap" MaxLines="2" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" RowSpacing="4" ColumnSpacing="4" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="40" /></Grid.RowDefinitions>
                                    <TextBlock x:Name="StartOffsetValue" TextAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock x:Name="OffsetSeparator" Text="–" Grid.Column="1" VerticalAlignment="Center" />
                                    <TextBlock x:Name="EndOffsetValue" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock x:Name="StartOffsetAdaptiveValue" Grid.Row="1" TextAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock x:Name="OffsetAdaptiveSeparator" Text="–" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" />
                                    <TextBlock x:Name="EndOffsetAdaptiveValue" Grid.Row="1" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock x:Name="DriveLetterLabel" Grid.Row="2" TextWrapping="Wrap" MaxLines="2" VerticalAlignment="Center" />
                                <Button x:Name="UndoDriveLetterButton" Grid.Row="2" Grid.Column="1" Style="{StaticResource WinPoolCompactIconButtonStyle}" Click="UndoDriveLetter_Click"><FontIcon Glyph="&#xE777;" FontSize="12" /></Button>
                                <controls:ContextHelpHost Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" VerticalAlignment="Center">
                                    <ComboBox x:Name="DriveLetterBox" Height="32" MinWidth="0" HorizontalAlignment="Stretch" SelectionChanged="DriveLetterBox_SelectionChanged" />
                                </controls:ContextHelpHost>
                                <Button x:Name="CommitDriveLetterButton" Grid.Row="2" Grid.Column="4" HorizontalAlignment="Center" Style="{StaticResource WinPoolCompactIconButtonStyle}" Click="CommitDriveLetter_Click"><FontIcon Glyph="&#xE73E;" FontSize="12" /></Button>
                                <TextBlock x:Name="VolumeLabelCaption" Grid.Row="3" TextWrapping="Wrap" MaxLines="2" VerticalAlignment="Center" />
                                <Button x:Name="UndoVolumeLabelButton" Grid.Row="3" Grid.Column="1" Style="{StaticResource WinPoolCompactIconButtonStyle}" Click="UndoVolumeLabel_Click"><FontIcon Glyph="&#xE777;" FontSize="12" /></Button>
                                <controls:ContextHelpHost Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" VerticalAlignment="Center">
                                    <TextBox x:Name="VolumeLabelBox" Height="32" MinWidth="0" KeyDown="VolumeLabelBox_KeyDown" TextChanged="VolumeLabelBox_TextChanged" />
                                </controls:ContextHelpHost>
                                <Button x:Name="CommitVolumeLabelButton" Grid.Row="3" Grid.Column="4" HorizontalAlignment="Center" Style="{StaticResource WinPoolCompactIconButtonStyle}" Click="CommitVolumeLabel_Click"><FontIcon Glyph="&#xE73E;" FontSize="12" /></Button>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="PartitionSettingsCard" Padding="12" Style="{StaticResource WinPoolCardBorderStyle}">
                    <StackPanel Spacing="4">
                        <Button
                            x:Name="PartitionSettingsCardHeader"
                            Style="{StaticResource WinPoolButtonBaseStyle}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            MinHeight="32"
                            Padding="0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Click="PropertyCardHeader_Click">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="PartitionSettingsCardTitle" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <FontIcon x:Name="PartitionSettingsCardDirection" Grid.Column="1" Glyph="&#xE70D;" FontSize="12" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <StackPanel x:Name="PartitionSettingsCardContent" Spacing="4">
                            <Grid x:Name="PartitionSettingsFormGrid" ColumnSpacing="4" RowSpacing="4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="84" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="40" /><RowDefinition Height="84" /><RowDefinition Height="40" /><RowDefinition Height="40" /><RowDefinition Height="40" /><RowDefinition Height="40" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="PartitionTypeLabel" Grid.Row="0" TextWrapping="Wrap" MaxLines="2" VerticalAlignment="Center" />
                                <controls:ContextHelpHost Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="3" VerticalAlignment="Center">
                                    <ComboBox x:Name="PartitionTypeBox" Height="32" MinWidth="0" HorizontalAlignment="Stretch" SelectionChanged="PartitionTypeBox_SelectionChanged" />
                                </controls:ContextHelpHost>
                                <Grid Grid.Row="1" VerticalAlignment="Center" ColumnSpacing="4" RowSpacing="4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="40" /></Grid.RowDefinitions>
                                    <TextBlock x:Name="SizeLabel" TextWrapping="Wrap" MaxLines="2" VerticalAlignment="Center" />
                                    <TextBlock x:Name="SizeAdaptiveLabel" Grid.Row="1" TextWrapping="Wrap" MaxLines="2" VerticalAlignment="Center" />
                                    <Border x:Name="SizeChangedIndicator" Grid.Column="1" Width="6" Height="6" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="3" Visibility="Collapsed" />
                                </Grid>
                                <Button x:Name="ResetSizeButton" Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" Margin="0,4,0,0" Style="{StaticResource WinPoolCompactIconButtonStyle}" Click="ResetSize_Click" Visibility="Collapsed"><FontIcon Glyph="&#xE777;" FontSize="12" /></Button>
                                <Grid Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" ColumnSpacing="4" RowSpacing="4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="40" /></Grid.RowDefinitions>
                                    <controls:ContextHelpHost VerticalAlignment="Center">
                                        <TextBox x:Name="SizeBox" TextAlignment="Right" MinWidth="0" Height="32" TextChanged="SizeBox_TextChanged" />
                                    </controls:ContextHelpHost>
                                    <TextBlock Grid.Column="1" Text="MiB" VerticalAlignment="Center" />
                                    <Button x:Name="MaximumSizeButton" Grid.Column="2" Content="MAX" MinWidth="0" Height="32" Padding="4,0" Style="{StaticResource WinPoolButtonBaseStyle}" Click="MaximumSize_Click" />
                                    <TextBox x:Name="SizeAdaptiveValue" TextAlignment="Right" Grid.Row="1" MinWidth="0" Height="32" IsReadOnly="True" />
                                    <TextBlock x:Name="SizeAdaptiveUnit" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Grid.Row="2" ColumnSpacing="4" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="FileSystemLabel" TextWrapping="Wrap" MaxLines="2" VerticalAlignment="Center" />
                                    <Border x:Name="FileSystemChangedIndicator" Grid.Column="1" Width="6" Height="6" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="3" Visibility="Collapsed" />
                                </Grid>
                                <Button x:Name="ResetFileSystemButton" Grid.Row="2" Grid.Column="1" Style="{StaticResource WinPoolCompactIconButtonStyle}" Click="ResetFileSystem_Click" Visibility="Collapsed"><FontIcon Glyph="&#xE777;" FontSize="12" /></Button>
                                <controls:ContextHelpHost Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3" VerticalAlignment="Center"><ComboBox x:Name="FileSystemBox" Height="32" MinWidth="0" HorizontalAlignment="Stretch" SelectionChanged="FileSystemBox_SelectionChanged" /></controls:ContextHelpHost>
                                <Grid Grid.Row="3" ColumnSpacing="4" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ClusterLabel" TextWrapping="Wrap" MaxLines="2" VerticalAlignment="Center" />
                                    <Border x:Name="ClusterChangedIndicator" Grid.Column="1" Width="6" Height="6" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="3" Visibility="Collapsed" />
                                </Grid>
                                <Button x:Name="ResetClusterButton" Grid.Row="3" Grid.Column="1" Style="{StaticResource WinPoolCompactIconButtonStyle}" Click="ResetCluster_Click" Visibility="Collapsed"><FontIcon Glyph="&#xE777;" FontSize="12" /></Button>
                                <controls:ContextHelpHost Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="3" VerticalAlignment="Center"><ComboBox x:Name="ClusterBox" Height="32" MinWidth="0" HorizontalAlignment="Stretch" SelectionChanged="ClusterBox_SelectionChanged" /></controls:ContextHelpHost>
                                <Grid Grid.Row="4" ColumnSpacing="4" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="QuickFormatLabel" TextWrapping="Wrap" MaxLines="2" VerticalAlignment="Center" />
                                    <Border x:Name="QuickFormatChangedIndicator" Grid.Column="1" Width="6" Height="6" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="3" Visibility="Collapsed" />
                                </Grid>
                                <Button x:Name="ResetQuickFormatButton" Grid.Row="4" Grid.Column="1" Style="{StaticResource WinPoolCompactIconButtonStyle}" Click="ResetQuickFormat_Click" Visibility="Collapsed"><FontIcon Glyph="&#xE777;" FontSize="12" /></Button>
                                <controls:ContextHelpHost Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="3" VerticalAlignment="Center"><ToggleSwitch x:Name="QuickFormatSwitch" Height="32" MinHeight="32" MinWidth="0" IsOn="True" OffContent="" OnContent="" Toggled="FormatModeSwitch_Toggled" /></controls:ContextHelpHost>
                                <TextBlock x:Name="FullFormatLabel" Grid.Row="5" TextWrapping="Wrap" MaxLines="2" VerticalAlignment="Center" />
                                <controls:ContextHelpHost Grid.Row="5" Grid.Column="2" Grid.ColumnSpan="3" VerticalAlignment="Center"><ToggleSwitch x:Name="FullFormatSwitch" Height="32" MinHeight="32" MinWidth="0" IsOn="False" OffContent="" OnContent="" Toggled="FormatModeSwitch_Toggled" /></controls:ContextHelpHost>
                            </Grid>
                            <controls:ContextHelpHost>
                                <Button x:Name="PartitionActionButton" Style="{StaticResource WinPoolButtonBaseStyle}" HorizontalAlignment="Stretch" Click="PartitionActionButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon x:Name="PartitionActionButtonIcon" Glyph="&#xE710;" FontSize="14" /><TextBlock x:Name="PartitionActionButtonLabel" VerticalAlignment="Center" /></StackPanel>
                                </Button>
                            </controls:ContextHelpHost>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        </Grid>
        <Border x:Name="RealTopologyOverlay" Grid.RowSpan="2" Background="#B3000000" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="16">
                <ProgressRing x:Name="RealTopologyProgress" IsActive="False" Width="72" Height="72" />
                <TextBlock x:Name="RealTopologyPhase" Foreground="White" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</editors:EditorPageBase>
