<?xml version="1.0" encoding="utf-8"?>
<editors:EditorPageBase
    x:Class="WinPool_App.DiskPartitionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinPool_App.Controls"
    xmlns:editors="using:WinPool_App"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="120" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="320" MinWidth="240" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <ScrollViewer
                x:Name="TopologyScrollViewer"
                Padding="8"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Enabled"
                SizeChanged="TopologyScrollViewer_SizeChanged"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl
                    x:Name="TopologyControl"
                    HorizontalAlignment="Stretch">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:TopologyNodeControl
                                HorizontalAlignment="Stretch"
                                ViewModel="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <toolkit:GridSplitter
            Grid.Column="1"
            Grid.RowSpan="2"
            HorizontalAlignment="Stretch"
            Background="{ThemeResource CardStrokeColorDefaultBrush}"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Columns"
            AutomationProperties.Name="Resize topology and properties" />
        <Border
            x:Name="PartitionChromeBorder"
            Grid.Row="1"
            Margin="0,8,0,0"
            Padding="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <StackPanel Spacing="6">
                <ScrollViewer
                    x:Name="PartitionActionsScrollViewer"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    MaxHeight="220"
                    SizeChanged="PartitionActionsScrollViewer_SizeChanged"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Enabled">
                <controls:FixedWrapPanel
                    x:Name="PartitionActionsPanel"
                    Width="176"
                    ItemWidth="176"
                    MinimumItemHeight="44"
                    Spacing="6">
                <controls:ContextHelpHost>
                <Button
                    x:Name="OnlineButton"
                    Style="{StaticResource WinPoolButtonBaseStyle}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Click="Online_Click">
                    <Grid HorizontalAlignment="Center" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8FB;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="OnlineButtonLabel"
                            Grid.Column="1"
                            MaxWidth="128"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                    </Grid>
                </Button>
                </controls:ContextHelpHost>
                <controls:ContextHelpHost>
                <Button
                    x:Name="OfflineButton"
                    Grid.Column="1"
                    Style="{StaticResource WinPoolButtonBaseStyle}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Click="Offline_Click">
                    <Grid HorizontalAlignment="Center" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8AE;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="OfflineButtonLabel"
                            Grid.Column="1"
                            MaxWidth="128"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                    </Grid>
                </Button>
                </controls:ContextHelpHost>
                <controls:ContextHelpHost>
                <Button
                    x:Name="InitializeButton"
                    Grid.Column="2"
                    Style="{StaticResource WinPoolButtonBaseStyle}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Click="Initialize_Click">
                    <Grid HorizontalAlignment="Center" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE9CE;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="InitializeButtonLabel"
                            Grid.Column="1"
                            MaxWidth="128"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                    </Grid>
                </Button>
                </controls:ContextHelpHost>
                <controls:ContextHelpHost>
                <Button
                    x:Name="ConvertGptButton"
                    Grid.Column="3"
                    Style="{StaticResource WinPoolButtonBaseStyle}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Click="ConvertGpt_Click">
                    <Grid HorizontalAlignment="Center" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8AB;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="ConvertGptButtonLabel"
                            Grid.Column="1"
                            MaxWidth="128"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                    </Grid>
                </Button>
                </controls:ContextHelpHost>
                <controls:ContextHelpHost>
                <Button
                    x:Name="DeletePartitionButton"
                    Grid.Column="4"
                    Style="{StaticResource WinPoolButtonBaseStyle}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Click="DeletePartition_Click">
                    <Grid HorizontalAlignment="Center" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE74D;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="DeletePartitionButtonLabel"
                            Grid.Column="1"
                            MaxWidth="128"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                    </Grid>
                </Button>
                </controls:ContextHelpHost>
                <controls:ContextHelpHost>
                <Button
                    x:Name="ExtendButton"
                    Grid.Column="5"
                    Style="{StaticResource WinPoolButtonBaseStyle}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Click="Extend_Click">
                    <Grid HorizontalAlignment="Center" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8A5;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="ExtendButtonLabel"
                            Grid.Column="1"
                            MaxWidth="128"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                    </Grid>
                </Button>
                </controls:ContextHelpHost>
                <controls:ContextHelpHost>
                <Button
                    x:Name="ShrinkButton"
                    Grid.Column="6"
                    Style="{StaticResource WinPoolButtonBaseStyle}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Click="Shrink_Click">
                    <Grid HorizontalAlignment="Center" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE73F;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="ShrinkButtonLabel"
                            Grid.Column="1"
                            MaxWidth="128"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                    </Grid>
                </Button>
                </controls:ContextHelpHost>
                <controls:ContextHelpHost>
                <Button
                    x:Name="OpenExplorerButton"
                    Grid.Column="7"
                    Style="{StaticResource WinPoolButtonBaseStyle}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Click="OpenExplorer_Click">
                    <Grid HorizontalAlignment="Center" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE838;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="OpenExplorerButtonLabel"
                            Grid.Column="1"
                            MaxWidth="128"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                    </Grid>
                </Button>
                </controls:ContextHelpHost>
                </controls:FixedWrapPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>
        <ScrollViewer
            Grid.Column="2"
            Grid.RowSpan="2"
            VerticalAlignment="Stretch"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled">
                <StackPanel>
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Grid
                            x:Name="PartitionFormGrid"
                            Margin="8"
                            ColumnSpacing="6"
                            RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" MinHeight="40" />
                                <RowDefinition Height="Auto" MinHeight="40" />
                                <RowDefinition Height="Auto" MinHeight="40" />
                                <RowDefinition Height="Auto" MinHeight="40" />
                                <RowDefinition Height="Auto" MinHeight="40" />
                                <RowDefinition Height="Auto" MinHeight="40" />
                                <RowDefinition Height="Auto" MinHeight="40" />
                                <RowDefinition Height="Auto" MinHeight="40" />
                                <RowDefinition Height="Auto" MinHeight="40" />
                                <RowDefinition Height="Auto" MinHeight="40" />
                                <RowDefinition Height="Auto" MinHeight="40" />
                                <RowDefinition Height="Auto" MinHeight="40" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                x:Name="DiskLocationLabel"
                                TextWrapping="Wrap"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="DiskLocationValue"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="PartitionNumberLabel"
                                Grid.Row="1"
                                TextWrapping="Wrap"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="PartitionNumberValue"
                                Grid.Row="1"
                                Grid.Column="2"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="StartOffsetLabel"
                                Grid.Row="2"
                                TextWrapping="Wrap"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="EndOffsetLabel"
                                Grid.Row="3"
                                TextWrapping="Wrap"
                                VerticalAlignment="Center" />
                            <Grid
                                Grid.Row="2"
                                Grid.Column="1"
                                Grid.ColumnSpan="2"
                                ColumnSpacing="0"
                                VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="StartOffsetValue"
                                    Grid.Column="0"
                                    TextAlignment="Right"
                                    TextWrapping="NoWrap"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="StartOffsetMibPrefixValue"
                                    Grid.Column="1"
                                    Text="MiB ("
                                    TextWrapping="NoWrap"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="StartOffsetAdaptiveValue"
                                    Grid.Column="2"
                                    TextAlignment="Right"
                                    TextWrapping="NoWrap"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="StartOffsetUnitValue"
                                    Grid.Column="3"
                                    TextWrapping="NoWrap"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="StartOffsetUnavailableValue"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="4"
                                    Text="—"
                                    TextAlignment="Right"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center" />
                            </Grid>
                            <Grid
                                Grid.Row="3"
                                Grid.Column="1"
                                Grid.ColumnSpan="2"
                                ColumnSpacing="0"
                                VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="EndOffsetValue"
                                    Grid.Column="0"
                                    TextAlignment="Right"
                                    TextWrapping="NoWrap"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="EndOffsetMibPrefixValue"
                                    Grid.Column="1"
                                    Text="MiB ("
                                    TextWrapping="NoWrap"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="EndOffsetAdaptiveValue"
                                    Grid.Column="2"
                                    TextAlignment="Right"
                                    TextWrapping="NoWrap"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="EndOffsetUnitValue"
                                    Grid.Column="3"
                                    TextWrapping="NoWrap"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="EndOffsetUnavailableValue"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="4"
                                    Text="—"
                                    TextAlignment="Right"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock
                                x:Name="PartitionTypeLabel"
                                Grid.Row="4"
                                TextWrapping="Wrap"
                                VerticalAlignment="Center" />
                            <controls:ContextHelpHost Grid.Row="4" Grid.Column="2">
                                <ComboBox
                                    x:Name="PartitionTypeBox"
                                    MinHeight="32"
                                    HorizontalAlignment="Stretch"
                                    SelectionChanged="PartitionTypeBox_SelectionChanged" />
                            </controls:ContextHelpHost>
                            <TextBlock
                                x:Name="DriveLetterLabel"
                                Grid.Row="5"
                                TextWrapping="Wrap"
                                VerticalAlignment="Center" />
                            <controls:ContextHelpHost Grid.Row="5" Grid.Column="2">
                                <ComboBox
                                    x:Name="DriveLetterBox"
                                    MinHeight="32"
                                    HorizontalAlignment="Stretch"
                                    SelectionChanged="DriveLetterBox_SelectionChanged" />
                            </controls:ContextHelpHost>
                            <TextBlock
                                x:Name="VolumeLabelCaption"
                                Grid.Row="6"
                                TextWrapping="Wrap"
                                VerticalAlignment="Center" />
                            <controls:ContextHelpHost Grid.Row="6" Grid.Column="2">
                                <TextBox
                                    x:Name="VolumeLabelBox"
                                    MinHeight="32"
                                    KeyDown="VolumeLabelBox_KeyDown" />
                            </controls:ContextHelpHost>
                            <Grid
                                Grid.Row="7"
                                ColumnSpacing="5"
                                VerticalAlignment="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SizeLabel" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Border
                                    x:Name="SizeChangedIndicator"
                                    Grid.Column="1"
                                    Width="6"
                                    Height="6"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="3"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed" />
                            </Grid>
                            <Button
                                x:Name="ResetSizeButton"
                                Grid.Row="7"
                                Grid.Column="1"
                                Style="{StaticResource WinPoolInlineIconButtonStyle}"
                                Click="ResetSize_Click"
                                VerticalAlignment="Top"
                                Visibility="Collapsed">
                                <FontIcon Glyph="&#xE777;" FontSize="12" />
                            </Button>
                            <controls:ContextHelpHost Grid.Row="7" Grid.Column="2">
                                <Grid ColumnSpacing="6" RowSpacing="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBox
                                        x:Name="SizeBox"
                                        Grid.Column="0"
                                        MinWidth="0"
                                        MinHeight="32"
                                        TextChanged="SizeBox_TextChanged" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="MiB"
                                        Margin="0,0,2,0"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        x:Name="SizeAdaptiveValue"
                                        Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        VerticalAlignment="Center" />
                                    <controls:ContextHelpHost Grid.Column="2" Grid.Row="0">
                                        <Button
                                            x:Name="MaximumSizeButton"
                                            Style="{StaticResource WinPoolInlineIconButtonStyle}"
                                            VerticalAlignment="Center"
                                            Click="MaximumSize_Click">
                                            <FontIcon Glyph="&#xE74E;" FontSize="14" />
                                        </Button>
                                    </controls:ContextHelpHost>
                                </Grid>
                            </controls:ContextHelpHost>
                            <Grid
                                Grid.Row="8"
                                ColumnSpacing="5"
                                VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="FileSystemLabel" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Border
                                    x:Name="FileSystemChangedIndicator"
                                    Grid.Column="1"
                                    Width="6"
                                    Height="6"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="3"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed" />
                            </Grid>
                            <Button
                                x:Name="ResetFileSystemButton"
                                Grid.Row="8"
                                Grid.Column="1"
                                Style="{StaticResource WinPoolInlineIconButtonStyle}"
                                VerticalAlignment="Center"
                                Click="ResetFileSystem_Click"
                                Visibility="Collapsed">
                                <FontIcon Glyph="&#xE777;" FontSize="12" />
                            </Button>
                            <controls:ContextHelpHost Grid.Row="8" Grid.Column="2">
                                <ComboBox
                                    x:Name="FileSystemBox"
                                    MinHeight="32"
                                    HorizontalAlignment="Stretch"
                                    SelectionChanged="FileSystemBox_SelectionChanged" />
                            </controls:ContextHelpHost>
                            <Grid
                                Grid.Row="9"
                                ColumnSpacing="5"
                                VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ClusterLabel" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Border
                                    x:Name="ClusterChangedIndicator"
                                    Grid.Column="1"
                                    Width="6"
                                    Height="6"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="3"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed" />
                            </Grid>
                            <Button
                                x:Name="ResetClusterButton"
                                Grid.Row="9"
                                Grid.Column="1"
                                Style="{StaticResource WinPoolInlineIconButtonStyle}"
                                VerticalAlignment="Center"
                                Click="ResetCluster_Click"
                                Visibility="Collapsed">
                                <FontIcon Glyph="&#xE777;" FontSize="12" />
                            </Button>
                            <controls:ContextHelpHost Grid.Row="9" Grid.Column="2">
                                <ComboBox
                                    x:Name="ClusterBox"
                                    MinHeight="32"
                                    HorizontalAlignment="Stretch"
                                    SelectionChanged="ClusterBox_SelectionChanged" />
                            </controls:ContextHelpHost>
                            <Grid
                                Grid.Row="10"
                                ColumnSpacing="5"
                                VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="QuickFormatLabel" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Border
                                    x:Name="QuickFormatChangedIndicator"
                                    Grid.Column="1"
                                    Width="6"
                                    Height="6"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="3"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed" />
                            </Grid>
                            <Button
                                x:Name="ResetQuickFormatButton"
                                Grid.Row="10"
                                Grid.Column="1"
                                Style="{StaticResource WinPoolInlineIconButtonStyle}"
                                VerticalAlignment="Center"
                                Click="ResetQuickFormat_Click"
                                Visibility="Collapsed">
                                <FontIcon Glyph="&#xE777;" FontSize="12" />
                            </Button>
                            <controls:ContextHelpHost Grid.Row="10" Grid.Column="2">
                                <ToggleSwitch
                                    x:Name="QuickFormatSwitch"
                                    MinHeight="32"
                                    MinWidth="0"
                                    Margin="0"
                                    IsOn="True"
                                    OffContent=""
                                    OnContent=""
                                    Toggled="FormatModeSwitch_Toggled" />
                            </controls:ContextHelpHost>
                            <TextBlock
                                x:Name="FullFormatLabel"
                                Grid.Row="11"
                                TextWrapping="Wrap"
                                VerticalAlignment="Center" />
                            <controls:ContextHelpHost Grid.Row="11" Grid.Column="2">
                                <ToggleSwitch
                                    x:Name="FullFormatSwitch"
                                    MinHeight="32"
                                    MinWidth="0"
                                    Margin="0"
                                    IsOn="False"
                                    OffContent=""
                                    OnContent=""
                                    Toggled="FormatModeSwitch_Toggled" />
                            </controls:ContextHelpHost>
                        </Grid>
                    </Border>
                    <controls:ContextHelpHost Margin="0,8,0,0">
                        <Button
                            x:Name="PartitionActionButton"
                            Style="{StaticResource WinPoolButtonBaseStyle}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Click="PartitionActionButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon x:Name="PartitionActionButtonIcon" Glyph="&#xE710;" FontSize="14" />
                                <TextBlock x:Name="PartitionActionButtonLabel" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </controls:ContextHelpHost>
                </StackPanel>
            </ScrollViewer>
    </Grid>
</editors:EditorPageBase>
